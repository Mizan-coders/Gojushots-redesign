<link rel="stylesheet" href="{{ 'component-goju-btn.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-goju-btn.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .ss-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#1F1A17' }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 40px;
    padding-right: 40px;
    position: relative;
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    .ss-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Decorative circle — top-right corner */
  .ss-{{ section.id }}::before {
    content: '';
    position: absolute;
    right: -100px;
    top: -100px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    pointer-events: none;
    z-index: 0;
  }

  /* Inner grid */
  .ss-{{ section.id }} .ss__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  /* ── Left: content ── */
  .ss-{{ section.id }} .ss__eyebrow {
    font-size: {{ section.settings.eyebrow_size | default: 11 }}px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color | default: '#F7F1E4' }};
    margin: 0 0 16px;
    display: block;
  }
  .ss-{{ section.id }} .ss__title {
    font-size: clamp({{ section.settings.heading_size | times: 0.64 | round }}px, {{ section.settings.heading_size | times: 0.071 }}vw, {{ section.settings.heading_size }}px);
    font-weight: {{ section.settings.heading_weight | default: 700 }};
    line-height: 1.05;
    text-transform: {{ section.settings.heading_transform | default: 'uppercase' }};
    letter-spacing: 0.02em;
    color: {{ section.settings.heading_color | default: '#ffffff' }};
    margin: 0;
  }
  .ss-{{ section.id }} .ss__title em {
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    color: {{ section.settings.italic_color | default: '#d4f24a' }};
    display: block;
    letter-spacing: 0;
  }
  .ss-{{ section.id }} .ss__body {
    font-size: {{ section.settings.body_size | default: 16 }}px;
    color: {{ section.settings.body_color | default: '#d4cfc8' }};
    line-height: 1.65;
    margin: 20px 0 0;
  }

  /* Perks */
  .ss-{{ section.id }} .ss__perks {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ss-{{ section.id }} .ss__perk {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .ss-{{ section.id }} .ss__perk-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(212,242,74,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    flex-shrink: 0;
  }
  .ss-{{ section.id }} .ss__perk-icon--img {
    background: transparent;
    border-radius: 0;
  }
  .ss-{{ section.id }} .ss__perk-icon--img img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: block;
  }
  .ss-{{ section.id }} .ss__perk-text {
    font-size: 14px;
    color: {{ section.settings.perk_text_color | default: '#d9d4cd' }};
    font-weight: 500;
    line-height: 1.4;
  }

  /* ── Right: glass card ── */
  .ss-{{ section.id }} .ss__card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 40px;
  }
  .ss-{{ section.id }} .ss__card-title {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: white;
    margin: 0 0 8px;
    line-height: 1.1;
  }
  .ss-{{ section.id }} .ss__card-sub {
    font-size: 14px;
    color: rgba(255,255,255,0.55);
    margin: 0 0 24px;
    line-height: 1.5;
  }

  /* Subscribe button (full-width, dark pill) */
  .ss-{{ section.id }} .ss__sub-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 24px;
    border-radius: 50px;
    background: rgba(0,0,0,0.35);
    color: white;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.1);
    transition: background 0.2s ease, transform 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .ss-{{ section.id }} .ss__sub-btn:hover {
    background: rgba(0,0,0,0.5);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(212,242,74,0.3);
  }
  .ss-{{ section.id }} .ss__sub-note {
    font-size: 12px;
    color: rgba(255,255,255,0.4);
    text-align: center;
    margin: 12px 0 0;
  }

  /* Divider */
  .ss-{{ section.id }} .ss__divider {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 20px 0;
  }

  /* Offer text */
  .ss-{{ section.id }} .ss__offer {
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    text-align: center;
    margin: 0 0 14px;
  }
  .ss-{{ section.id }} .ss__offer-hl {
    color: var(--goju-accent);
    font-weight: 700;
  }

  /* Email form row */
  .ss-{{ section.id }} .ss__form-row {
    display: flex;
    gap: 10px;
  }
  .ss-{{ section.id }} .ss__input {
    flex: 1;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
    padding: 14px 18px;
    border-radius: 50px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
    min-width: 0;
  }
  .ss-{{ section.id }} .ss__input::placeholder {
    color: rgba(255,255,255,0.4);
  }
  .ss-{{ section.id }} .ss__input:focus {
    border-color: var(--goju-accent) !important;
    outline: none !important;
    box-shadow: 0 0 0 2px rgba(212,242,74,0.25);
  }
  .ss-{{ section.id }} .ss__submit {
    background: var(--goju-accent);
    color: var(--goju-accent-text);
    padding: 14px 22px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    font-family: inherit;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .ss-{{ section.id }} .ss__submit:hover {
    transform: scale(1.03);
  }

  /* Form messages */
  .ss-{{ section.id }} .ss__form-msg {
    font-size: 13px;
    margin-top: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    line-height: 1.5;
  }
  .ss-{{ section.id }} .ss__form-msg--success {
    background: rgba(212,242,74,0.12);
    color: var(--goju-accent);
  }
  .ss-{{ section.id }} .ss__form-msg--error {
    background: rgba(255,80,80,0.1);
    color: rgba(255,150,150,0.9);
  }

  /* ── Mobile ── */
  @media screen and (max-width: 989px) {
    .ss-{{ section.id }} {
      padding-left: 20px;
      padding-right: 20px;
    }
    .ss-{{ section.id }} .ss__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media screen and (max-width: 479px) {
    .ss-{{ section.id }} .ss__card {
      padding: 28px 20px;
    }
    .ss-{{ section.id }} .ss__form-row {
      flex-direction: column;
    }
    .ss-{{ section.id }} .ss__submit {
      width: 100%;
      text-align: center;
    }
  }

  /* ── Klaviyo embed form overrides ── */
  .ss-{{ section.id }} .klaviyo-form-UPhmbR > div {
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
    max-width: none !important;
  }
  /* Klaviyo sets a fixed pixel width inline on its own class divs — override it */
  .ss-{{ section.id }} .klaviyo-form-UPhmbR div[class*="klaviyo"] {
    width: 100% !important;
    max-width: 100% !important;
    background: transparent !important;
    padding: 0 !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR form {
    display: flex !important;
    flex-direction: row !important;
    gap: 10px !important;
    align-items: center !important;
    background: transparent !important;
    padding: 0 !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR form > div {
    flex-shrink: 0 !important;
    width: auto !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR form > div:first-child {
    flex: 1 !important;
    min-width: 0 !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR div[class*="klaviyo"] {
    background: transparent !important;
    padding: 0 !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="email"],
  .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="text"] {
    flex: 1 !important;
    background: rgba(255,255,255,0.1) !important;
    border: 1px solid rgba(255,255,255,0.2) !important;
    color: white !important;
    padding: 14px 18px !important;
    border-radius: 50px !important;
    font-size: 14px !important;
    font-family: inherit !important;
    outline: none !important;
    min-width: 0 !important;
    width: auto !important;
    margin: 0 !important;
    height: auto !important;
    box-shadow: none !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="email"]::placeholder,
  .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="text"]::placeholder {
    color: rgba(255,255,255,0.4) !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="email"]:focus,
  .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="text"]:focus {
    border-color: var(--goju-accent) !important;
    box-shadow: 0 0 0 2px rgba(212,242,74,0.25) !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR button[type="submit"] {
    background: var(--goju-accent, #d4f24a) !important;
    color: #1F1A17 !important;
    padding: 14px 22px !important;
    border-radius: 50px !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    border: none !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    font-family: inherit !important;
    flex-shrink: 0 !important;
    width: auto !important;
    margin: 0 !important;
    height: auto !important;
    letter-spacing: 0.02em !important;
    transition: transform 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .ss-{{ section.id }} .klaviyo-form-UPhmbR button[type="submit"]:hover {
    transform: scale(1.03) !important;
  }
  @media screen and (max-width: 479px) {
    .ss-{{ section.id }} .klaviyo-form-UPhmbR form {
      flex-direction: column !important;
      align-items: stretch !important;
    }
    .ss-{{ section.id }} .klaviyo-form-UPhmbR form > div,
    .ss-{{ section.id }} .klaviyo-form-UPhmbR form > div > div,
    .ss-{{ section.id }} .klaviyo-form-UPhmbR form > div > div > div {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      box-sizing: border-box !important;
    }
    .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="email"],
    .ss-{{ section.id }} .klaviyo-form-UPhmbR input[type="text"] {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .ss-{{ section.id }} .klaviyo-form-UPhmbR button[type="submit"] {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      text-align: center !important;
    }
  }
{%- endstyle -%}

<section class="ss-{{ section.id }}">
  <div class="ss__inner">

    {%- comment -%} ── Left: content ── {%- endcomment -%}
    <div class="ss__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ss__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      <h2 class="ss__title">
        {{- section.settings.title | escape -}}
        {%- if section.settings.title_italic != blank -%}
          <em>{{ section.settings.title_italic | escape }}</em>
        {%- endif -%}
      </h2>

      {%- if section.settings.body_text != blank -%}
        <p class="ss__body">{{ section.settings.body_text | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ss__perks" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'perk' -%}
              <li class="ss__perk" {{ block.shopify_attributes }}>
                {%- if block.settings.custom_icon != blank -%}
                  <span class="ss__perk-icon ss__perk-icon--img" aria-hidden="true">
                    <img src="{{ block.settings.custom_icon | image_url: width: 80 }}" alt="" width="38" height="38" loading="lazy">
                  </span>
                {%- elsif block.settings.icon != blank -%}
                  <span class="ss__perk-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {%- endif -%}
                <span class="ss__perk-text">{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ── Right: form card ── {%- endcomment -%}
    <div class="ss__card">
      {%- if section.settings.card_title != blank -%}
        <h3 class="ss__card-title">{{ section.settings.card_title | escape }}</h3>
      {%- endif -%}
      {%- if section.settings.card_subtitle != blank -%}
        <p class="ss__card-sub">{{ section.settings.card_subtitle | escape }}</p>
      {%- endif -%}

      {%- comment -%} Subscribe CTA button {%- endcomment -%}
      <a
        href="{{ section.settings.subscribe_url | default: '#' }}"
        class="ss__sub-btn"
      >
        {{- section.settings.subscribe_btn_label | default: 'Subscribe & Save 10%' | escape }} &rarr;
      </a>
      {%- if section.settings.subscribe_note != blank -%}
        <p class="ss__sub-note">{{ section.settings.subscribe_note | escape }}</p>
      {%- endif -%}

      <div class="ss__divider" role="separator"></div>

      {%- comment -%} Offer text {%- endcomment -%}
      {%- if section.settings.offer_prefix != blank or section.settings.offer_highlight != blank -%}
        <p class="ss__offer">
          {{- section.settings.offer_prefix | escape }}
          {%- if section.settings.offer_highlight != blank %}
            <strong class="ss__offer-hl">{{ section.settings.offer_highlight | escape }}</strong>
          {%- endif %}
          {{ section.settings.offer_suffix | escape -}}
        </p>
      {%- endif -%}

      {%- comment -%} Klaviyo embedded form {%- endcomment -%}
      <div class="klaviyo-form-UPhmbR"></div>

      <script>
      (function() {
        function applyKlaviyoStyles() {
          var wrap = document.querySelector('.ss-{{ section.id }} .klaviyo-form-UPhmbR');
          if (!wrap) return false;
          var input = wrap.querySelector('input[type="email"], input[type="text"]');
          var btn   = wrap.querySelector('button[type="submit"]');
          if (!input || !btn) return false;

          var isMobile = window.innerWidth <= 749;

          // Strip ALL wrapper elements of Klaviyo's background/border/spacing
          // Also force width:100% to override Klaviyo's JS-injected fixed pixel widths (e.g. 292px)
          wrap.querySelectorAll('*').forEach(function(el) {
            if (el === input || el === btn) return;
            el.style.setProperty('background', 'transparent', 'important');
            el.style.setProperty('background-color', 'transparent', 'important');
            el.style.setProperty('border', 'none', 'important');
            el.style.setProperty('outline', 'none', 'important');
            el.style.setProperty('box-shadow', 'none', 'important');
            el.style.setProperty('padding', '0', 'important');
            el.style.setProperty('margin', '0', 'important');
            el.style.setProperty('width', '100%', 'important');
            el.style.setProperty('max-width', '100%', 'important');
            el.style.setProperty('border-radius', '0', 'important');
            el.style.setProperty('box-sizing', 'border-box', 'important');
          });

          // Clear wrap outer div
          wrap.style.setProperty('background', 'transparent', 'important');
          wrap.style.setProperty('border', 'none', 'important');
          wrap.style.setProperty('box-shadow', 'none', 'important');
          wrap.style.setProperty('padding', '0', 'important');
          wrap.style.setProperty('margin', '0', 'important');
          wrap.style.setProperty('width', '100%', 'important');

          // Find the common container of input + button
          var container = input.parentElement;
          while (container && !container.contains(btn)) {
            container = container.parentElement;
          }
          if (container && container !== document.body) {
            container.style.setProperty('display', 'flex', 'important');
            container.style.setProperty('flex-direction', isMobile ? 'column' : 'row', 'important');
            container.style.setProperty('gap', '10px', 'important');
            container.style.setProperty('align-items', isMobile ? 'stretch' : 'center', 'important');
            container.style.setProperty('flex-wrap', 'nowrap', 'important');
            container.style.setProperty('width', '100%', 'important');
          }

          // Input wrapper: grow to fill
          var inputWrap = input.parentElement;
          if (inputWrap && inputWrap !== container) {
            inputWrap.style.setProperty('flex', '1', 'important');
            inputWrap.style.setProperty('min-width', '0', 'important');
            inputWrap.style.setProperty('width', '100%', 'important');
          }

          // Button wrapper + every ancestor up to wrap: force 100% wide on mobile
          if (isMobile) {
            var el = btn.parentElement;
            while (el && el !== wrap.parentElement) {
              el.style.setProperty('width', '100%', 'important');
              el.style.setProperty('box-sizing', 'border-box', 'important');
              el = el.parentElement;
            }
          } else {
            var btnWrap = btn.parentElement;
            if (btnWrap && btnWrap !== container) {
              btnWrap.style.setProperty('flex-shrink', '0', 'important');
              btnWrap.style.setProperty('width', 'auto', 'important');
            }
          }

          // Style input
          input.style.setProperty('background', 'rgba(255,255,255,0.1)', 'important');
          input.style.setProperty('border', '1px solid rgba(255,255,255,0.2)', 'important');
          input.style.setProperty('color', 'white', 'important');
          input.style.setProperty('padding', '14px 18px', 'important');
          input.style.setProperty('border-radius', '50px', 'important');
          input.style.setProperty('font-size', '14px', 'important');
          input.style.setProperty('width', '100%', 'important');
          input.style.setProperty('min-width', '0', 'important');
          input.style.setProperty('box-sizing', 'border-box', 'important');
          input.style.setProperty('box-shadow', 'none', 'important');
          input.style.setProperty('outline', 'none', 'important');
          input.style.setProperty('margin', '0', 'important');

          // Style button
          btn.style.setProperty('background', '#d4f24a', 'important');
          btn.style.setProperty('color', '#1F1A17', 'important');
          btn.style.setProperty('padding', '14px 22px', 'important');
          btn.style.setProperty('border-radius', '50px', 'important');
          btn.style.setProperty('font-size', '14px', 'important');
          btn.style.setProperty('font-weight', '700', 'important');
          btn.style.setProperty('border', 'none', 'important');
          btn.style.setProperty('cursor', 'pointer', 'important');
          btn.style.setProperty('white-space', 'nowrap', 'important');
          btn.style.setProperty('width', isMobile ? '100%' : 'auto', 'important');
          btn.style.setProperty('align-self', isMobile ? 'stretch' : 'auto', 'important');
          btn.style.setProperty('flex-shrink', '0', 'important');
          btn.style.setProperty('line-height', '1', 'important');
          btn.style.setProperty('letter-spacing', '0.02em', 'important');
          btn.style.setProperty('box-shadow', 'none', 'important');
          btn.style.setProperty('outline', 'none', 'important');
          btn.style.setProperty('margin', '0', 'important');
          btn.style.setProperty('box-sizing', 'border-box', 'important');

          // Hide empty sibling divs (Klaviyo error containers etc.)
          if (container && container.parentElement) {
            Array.from(container.parentElement.children).forEach(function(child) {
              if (child !== container && !child.querySelector('input, button')) {
                child.style.setProperty('display', 'none', 'important');
              }
            });
          }

          return true;
        }

        function watchKlaviyoWidths() {
          // Watch for Klaviyo re-injecting fixed pixel widths on its own divs
          var wrap = document.querySelector('.ss-{{ section.id }} .klaviyo-form-UPhmbR');
          if (!wrap) return;
          new MutationObserver(function() {
            wrap.querySelectorAll('div[class*="klaviyo"], div[class*="kl-"]').forEach(function(el) {
              el.style.setProperty('width', '100%', 'important');
              el.style.setProperty('max-width', '100%', 'important');
            });
          }).observe(wrap, { attributes: true, attributeFilter: ['style'], subtree: true });
        }

        function init() {
          if (applyKlaviyoStyles()) {
            setTimeout(applyKlaviyoStyles, 300);
            setTimeout(function() { applyKlaviyoStyles(); watchKlaviyoWidths(); }, 800);
            return;
          }
          var observer = new MutationObserver(function(mutations, obs) {
            if (applyKlaviyoStyles()) {
              obs.disconnect();
              setTimeout(applyKlaviyoStyles, 300);
              setTimeout(function() { applyKlaviyoStyles(); watchKlaviyoWidths(); }, 800);
            }
          });
          observer.observe(document.body, { childList: true, subtree: true });
        }
        init();

        window.addEventListener('resize', applyKlaviyoStyles);
      })();
      </script>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Subscribe & Save",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#1F1A17"
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Subscribe & Save"
    },
