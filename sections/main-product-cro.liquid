{%- comment -%} Per-product color tokens + section padding {%- endcomment -%}
{% style %}
  /* Per-product gallery bg driven by metafield */
  .cro-gallery__main-{{ section.id }} {
    background-color: {{ product.metafields.custom.primary_color | default: '#f3f3f3' }};
  }
  .cro-gallery__thumb-dot-{{ section.id }} {
    background-color: {{ product.metafields.custom.secondary_color | default: '#191917' }};
  }
  /* Section padding override */
  .cro-hero-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    .cro-hero-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
  {%- if section.settings.button_scheme == 'black' -%}
  #MainProduct-{{ section.id }} .cro-btn--primary {
    background: #191917;
  }
  #MainProduct-{{ section.id }} .cro-btn--primary:hover {
    background: #2d2d2b;
  }
  #MainProduct-{{ section.id }} .cro-pw__tog-btn.is-active {
    background: #191917;
    border-color: #191917;
  }
  #MainProduct-{{ section.id }} .cro-pw__freq-btn.is-active {
    background: #191917;
    border-color: #191917;
    color: #ffffff;
  }
  #MainProduct-{{ section.id }} .cro-sticky-atc__btn {
    background: #ffffff;
    color: #191917;
  }
  #MainProduct-{{ section.id }} .cro-sticky-atc__btn:hover {
    background: #e8e8e8;
    color: #191917;
  }
  {%- endif -%}
  {%- if section.settings.sticky_bg_color != blank and section.settings.sticky_bg_color != 'rgba(0,0,0,0)' -%}
  #CroStickyATC-{{ section.id }} {
    background: {{ section.settings.sticky_bg_color }};
  }
  {%- endif -%}
  {%- if section.settings.sticky_btn_color != blank and section.settings.sticky_btn_color != 'rgba(0,0,0,0)' -%}
  #CroStickyATC-{{ section.id }} .cro-sticky-atc__btn {
    background: {{ section.settings.sticky_btn_color }};
  }
  #CroStickyATC-{{ section.id }} .cro-sticky-atc__btn:hover:not(:disabled) {
    background: {{ section.settings.sticky_btn_color }};
    opacity: 1;
    filter: brightness(0.88);
  }
  {%- endif -%}
  {%- if section.settings.sticky_btn_text_color != blank and section.settings.sticky_btn_text_color != 'rgba(0,0,0,0)' -%}
  #CroStickyATC-{{ section.id }} .cro-sticky-atc__btn {
    color: {{ section.settings.sticky_btn_text_color }};
  }
  {%- endif -%}
  /* Hide subscription UI instantly for no-plan variants — prevents flash before JS runs */
  .cro-pw[data-variant-has-plans="0"] .cro-pw__toggle,
  .cro-pw[data-variant-has-plans="0"] .cro-pw__perks,
  .cro-pw[data-variant-has-plans="0"] .cro-pw__freq,
  .cro-pw[data-variant-has-plans="0"] .cro-pw__cancel-note { display: none !important; }
  /* ...but when ANOTHER pack is subscribable, the Subscribe option stays on
     screen. It is how the customer asks to switch — hiding it removes the
     entry point to subscription entirely on the smaller pack. The subscribe
     detail panels stay hidden until the switch has happened. */
  .cro-pw[data-variant-has-plans="0"][data-sub-elsewhere="true"] .cro-pw__toggle { display: flex !important; }

  /* ── Pack cards (Choose your pack) ──────────────────────────
     Selectors are scoped through `.pdp-cro` and the adjacent input so they
     out-rank Dawn's `.product-form__input input[type=radio] + label` rule,
     which otherwise restyles these as pill buttons. Selected state comes
     from :checked, not a server-rendered class, so it survives re-render. */
  .pdp-cro .cro-variant-row--cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    flex: 1 1 100%;
    margin: 14px 0 12px;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card {
    position: relative;
    display: block;
    border: 1.5px solid #E4E1D6;
    border-radius: 14px;
    padding: 18px 14px 14px;
    background: #fff;
    cursor: pointer;
    min-height: 0;
    text-align: left;
    transition: border-color .15s ease;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card:hover { border-color: #00823E; }
  .pdp-cro .cro-variant-row--cards input[type="radio"]:checked + .cro-pack-card {
    border-width: 2px;
    border-color: #00823E;
    padding: 17.5px 13.5px 13.5px;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"]:focus-visible + .cro-pack-card {
    outline: 2px solid #00823E;
    outline-offset: 2px;
  }
  /* Inner text colours are routed through `input[type="radio"] +` to reach
     specificity 0,5,0. Dawn's theme sets `...input[type=radio]+label span
     {color:#AFADA2}` and `:checked+label span {color:#32312E}` at 0,2,2 /
     0,3,2, which otherwise repaint the badge and pack text. */
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__badge {
    position: absolute;
    top: -11px;
    left: 12px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.6;
    padding: 2px 10px;
    border-radius: 20px;
    white-space: nowrap;
    display: inline-block;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__badge--start {
    background: #00823E;
    color: #FFFFFF;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__badge--value {
    background: #E6F2EA;
    color: #00823E;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__name {
    display: block; font-size: 15px; font-weight: 600; line-height: 1.3;
    margin: 4px 0 2px; color: #1A1A1A;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__price {
    display: block; font-size: 24px; font-weight: 700; line-height: 1.2;
    margin: 0 0 4px; color: #1A1A1A;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__sub {
    display: block; font-size: 13px; font-weight: 400; line-height: 1.45; color: #6B6B66;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__foot {
    display: none; font-size: 12px; font-weight: 600; line-height: 1.4; margin-top: 10px;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__foot--switch {
    display: block; color: #6B6B66; font-weight: 400;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"]:checked + .cro-pack-card .cro-pack-card__foot--switch {
    display: none;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"]:checked + .cro-pack-card .cro-pack-card__foot--sel {
    display: block; color: #00823E;
  }
  /* Sold out: grey the text rather than fading the whole card. A blanket
     opacity also washes out the border and background, which made the card
     look broken rather than deliberately unavailable. */
  .pdp-cro .cro-variant-row--cards input[type="radio"]:disabled + .cro-pack-card {
    /* Dawn strikes through disabled variant labels
       (.product-form__input input:disabled + label). The approved design greys
       the card instead — a struck-out price reads as a discount, not stock. */
    text-decoration: none;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out {
    cursor: not-allowed;
    background: #FCFCFA;
    border-color: #EDEBE3;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out:hover { border-color: #EDEBE3; }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out .cro-pack-card__name,
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out .cro-pack-card__price { color: #AFADA2; }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out .cro-pack-card__sub { color: #B8B6AC; }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out .cro-pack-card__badge--out {
    background: #EDEBE3;
    color: #8A887E;
  }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card--out .cro-pack-card__foot--switch { display: none; }
  .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card .cro-pack-card__foot--out {
    display: block; color: #B4685F; font-weight: 500;
  }
  @media screen and (max-width: 480px) {
    .pdp-cro .cro-variant-row--cards { gap: 10px; }
    .pdp-cro .cro-variant-row--cards input[type="radio"] + .cro-pack-card { padding: 16px 12px 12px; }
    .pdp-cro .cro-variant-row--cards .cro-pack-card__price { font-size: 21px; }
    .pdp-cro .cro-variant-row--cards .cro-pack-card__sub { font-size: 12px; }
  }

  /* ── Subscription blocked / sold-out messaging ────────────── */
  .pdp-cro .cro-pw__toggle--sub-blocked .cro-pw__tog-btn.is-blocked {
    cursor: not-allowed;
    color: #8A887E;
    background: transparent;
    border-color: #EDEBE3;
  }
  .pdp-cro .cro-pw__toggle--sub-blocked .cro-pw__tog-btn.is-blocked:hover {
    background: transparent;
  }
  .pdp-cro .cro-pw__sub-blocked-hint {
    font-size: 12px;
    line-height: 1.5;
    color: #6B6B66;
    /* Needs space on BOTH sides: with a top margin only, the price block sat
       flush against it. The toggle above contributes 16px of its own margin,
       which collapses with this one. */
    margin: 18px 0 22px;
  }
  .pdp-cro .cro-pw__sub-blocked-hint[hidden] { display: none; }
  .pdp-cro .cro-pw__sub-blocked-hint::before {
    content: 'ⓘ';
    margin-right: 6px;
    color: #8A887E;
  }
  .pdp-cro .cro-pw__soldout-note {
    font-size: 12.5px;
    line-height: 1.5;
    color: #A5453A;
    background: #FDF0EE;
    border: 1px solid #F5D9D4;
    border-radius: 10px;
    padding: 12px 14px;
    margin: 12px 0 0;
  }

  /* ── Sample Pack entry link ───────────────────────────────── */
  .pdp-cro .cro-sample-link {
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    color: #1A1A1A;
    margin: 14px 0 0;
  }
  .pdp-cro .cro-sample-link__lead { color: #1A1A1A; }
  .pdp-cro .cro-sample-link a {
    color: #00823E;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pdp-cro .cro-sample-link a:hover { color: #056230; }

  /* ── Pack auto-switch confirmation ────────────────────────── */
  .pdp-cro .cro-pw__switch-note {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: #1F4A33;
    background: #E6F2EA;
    border-radius: 12px;
    padding: 12px 14px;
    margin: 10px 0 0;
  }
  .pdp-cro .cro-pw__switch-note::before {
    content: '✓';
    color: #00823E;
    font-weight: 800;
    flex: none;
  }
  .pdp-cro .cro-pw__switch-note[hidden] { display: none; }

  /* ── Sold-out pack switch + all-sold-out ──────────────────── */
  .pdp-cro .cro-pw__switch-note--soldout {
    color: #7A5B23;
    background: #FBF3E2;
  }
  .pdp-cro .cro-pw__switch-note--soldout::before {
    content: '!';
    color: #B4863B;
  }
  .pdp-cro .cro-pw__all-soldout {
    font-size: 13px;
    line-height: 1.5;
    font-weight: 600;
    color: #A5453A;
    background: #FDF0EE;
    border: 1px solid #F5D9D4;
    border-radius: 12px;
    padding: 12px 14px;
    margin: 10px 0 0;
  }
{% endstyle %}

{%- assign product_form_id = 'product-form-cro-' | append: section.id -%}

<section
  class="pdp-cro cro-hero-section-{{ section.id }} shopify-section-main-product"
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="cro-container">
    <div class="cro-product-hero">

      {%- comment -%}═══════════════════════════════════════════
        LEFT PANEL — PRODUCT GALLERY
      ═══════════════════════════════════════════{%- endcomment -%}
      <div class="cro-gallery" id="CroGallery-{{ section.id }}">

        {%- comment -%} ── MAIN IMAGE AREA ── {%- endcomment -%}
        <div class="cro-gallery__main cro-gallery__main-{{ section.id }}">

          {%- comment -%} Best Seller / featured badge from product tags {%- endcomment -%}
          {%- if product.tags contains 'best-seller'
               or product.tags contains 'bestseller'
               or product.tags contains 'Best Seller'
               or product.tags contains 'BestSeller' -%}
            <span class="cro-gallery__badge cro-tag cro-tag--highlight">Best Seller</span>
          {%- elsif product.tags contains 'new'
                 or product.tags contains 'New'
                 or product.tags contains 'NEW' -%}
            <span class="cro-gallery__badge cro-tag cro-tag--dark">New</span>
          {%- endif -%}

          {%- comment -%} Main image slider — reuses existing snippet {%- endcomment -%}
          <div class="cro-gallery__slider-wrap">
            {%- if product.media.size > 0 -%}
              <div
                class="cro-gallery__slides"
                id="CroSlides-{{ section.id }}"
                aria-label="{{ 'products.modal.label' | t }}"
                tabindex="0"
              >
                {%- for media in product.media -%}
                  <div class="cro-gallery__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                    {%- if media.media_type == 'video' -%}
                      {{ media | media_tag: image_size: '900x', autoplay: false, loop: section.settings.enable_video_looping, controls: true, preload: 'none' }}
                    {%- elsif media.media_type == 'external_video' -%}
                      {{ media | media_tag: image_size: '900x', autoplay: false, loop: section.settings.enable_video_looping }}
                    {%- else -%}
                      <img
                        srcset="{{ media | img_url: '480x' }} 480w, {{ media | img_url: '720x' }} 720w, {{ media | img_url: '1080x' }} 1080w"
                        sizes="(min-width: 990px) 50vw, 100vw"
                        src="{{ media | img_url: '720x' }}"
                        {%- comment -%}
                          Liquid's media.alt returns the PRODUCT TITLE when no alt has
                          been entered against the image — it is not blank, so a
                          `default` filter never fires. Treating "alt equals the product
                          title" as "no real alt" is what makes the fallback work, so
                          gallery images are at least distinguishable to a screen reader.
                          A genuine description entered in the admin always wins.
                        {%- endcomment -%}
                        {%- capture media_alt -%}
                          {%- if media.alt != blank and media.alt != product.title -%}
                            {{ media.alt }}
                          {%- else -%}
                            {{ product.title }} — image {{ forloop.index }} of {{ product.media.size }}
                          {%- endif -%}
                        {%- endcapture -%}
                        alt="{{ media_alt | strip | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="{{ media.preview_image.width }}"
                        height="{{ media.preview_image.height }}"
                        data-media-id="{{ media.id }}"
                      >
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>

              {%- comment -%} Prev / Next arrows {%- endcomment -%}
              {%- if product.media.size > 1 -%}
                <button
                  class="cro-gallery__arrow cro-gallery__arrow--prev"
                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                  data-target="CroSlides-{{ section.id }}"
                  data-dir="-1"
                >
                  <svg width="9" height="16" viewBox="0 0 9 16" fill="none" aria-hidden="true">
                    <path d="M8 1L1 8L8 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button
                  class="cro-gallery__arrow cro-gallery__arrow--next"
                  aria-label="{{ 'general.slider.next_slide' | t }}"
                  data-target="CroSlides-{{ section.id }}"
                  data-dir="1"
                >
                  <svg width="9" height="16" viewBox="0 0 9 16" fill="none" aria-hidden="true">
                    <path d="M1 1L8 8L1 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              {%- endif -%}

            {%- else -%}
              {%- comment -%} No media fallback {%- endcomment -%}
              <div class="cro-gallery__slide is-active cro-gallery__no-media">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>{%- comment -%} /.cro-gallery__slider-wrap {%- endcomment -%}
        </div>{%- comment -%} /.cro-gallery__main {%- endcomment -%}

        {%- comment -%} ── THUMBNAIL STRIP ── {%- endcomment -%}
        {%- if product.media.size > 1 -%}
          <div class="cro-gallery__thumbs" id="CroThumbs-{{ section.id }}" role="tablist">
            {%- for media in product.media limit: 6 -%}
              <button class="cro-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" data-target="CroSlides-{{ section.id }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ media.alt | default: product.title | escape }}">
                {%- capture thumb_alt -%}{% if media.alt != blank and media.alt != product.title %}{{ media.alt }}{% else %}View image {{ forloop.index }} of {{ product.media.size }}{% endif %}{%- endcapture -%}<img src="{{ media | img_url: '120x120', crop: 'center' }}" alt="{{ thumb_alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="120" height="120">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}


      </div>{%- comment -%} /.cro-gallery {%- endcomment -%}

      {%- comment -%}═══════════════════════════════════════════
        RIGHT PANEL — PURCHASE INFO
        (built out in Task 3)
      ═══════════════════════════════════════════{%- endcomment -%}
      <div
        class="cro-info-panel"
        id="CroInfoPanel-{{ section.id }}"
      >
        <div
          class="cro-info-panel__sticky"
          id="CroInfoSticky-{{ section.id }}"
        >

          {%- comment -%}
            Phase gate. The new purchase experience — pack cards, one-time-first
            default, sold-out messaging, sample link — ships per product rather
            than to the whole range at once, because all 12 product templates
            share this section. The brief migrates products one at a time.

            Off: the product keeps its previous behaviour (pill selector,
            subscribe-first). On: the approved Action Shot experience.
          {%- endcomment -%}
          {%- assign cro_new_ux = section.settings.new_purchase_experience | default: false -%}

          {%- comment -%}
            Subscription availability, computed once for the whole panel so the
            toggle, the hint and the note under the CTA all read the same state.

            sub_blocked means: the product HAS subscribable variants, but none of
            them are in stock. That is different from a product that simply never
            offers subscription (no_sub / no selling plans at all), which must not
            show an "unavailable" message.
          {%- endcomment -%}
          {%- liquid
            assign cro_no_sub = false
            if product.tags contains 'no-subscription'
              assign cro_no_sub = true
            endif
            assign cro_sub_exists = false
            assign cro_sub_in_stock = false
            assign cro_sub_labels = ''
            assign cro_sub_count = 0
            assign cro_soldout_labels = ''
            unless cro_no_sub
              for v in product.variants
                if v.selling_plan_allocations.size > 0
                  assign cro_sub_exists = true
                  assign cro_sub_count = cro_sub_count | plus: 1
                  if cro_sub_labels == ''
                    assign cro_sub_labels = v.title
                  else
                    assign cro_sub_labels = cro_sub_labels | append: ' and ' | append: v.title
                  endif
                  if v.available
                    assign cro_sub_in_stock = true
                  endif
                endif
              endfor
            endunless
            for v in product.variants
              unless v.available
                if cro_soldout_labels == ''
                  assign cro_soldout_labels = v.title
                else
                  assign cro_soldout_labels = cro_soldout_labels | append: ' and ' | append: v.title
                endif
              endunless
            endfor
            assign cro_sub_blocked = false
            if cro_sub_exists and cro_sub_in_stock == false
              assign cro_sub_blocked = true
            endif

            comment
              Deep links and saved selections can point at a pack that is now
              sold out. selected_or_first_available_variant returns the
              requested variant even when unavailable, so this detects that
              case and names a pack we can move the customer to instead.
            endcomment
            assign cro_any_available = false
            assign cro_first_available = ''
            for v in product.variants
              if v.available and cro_first_available == ''
                assign cro_any_available = true
                assign cro_first_available = v.title
              endif
            endfor
            assign cro_selected_variant = product.selected_or_first_available_variant
            assign cro_deeplink_soldout = false
            if cro_selected_variant.available == false and cro_any_available
              assign cro_deeplink_soldout = true
            endif

            comment
              Whether the pack the customer is looking at can itself be
              subscribed to. Drives the hint under the purchase toggle: there is
              no point telling someone Subscribe will move them to another pack
              when they are already on it.
            endcomment
            assign cro_current_subscribable = false
            if cro_selected_variant.selling_plan_allocations.size > 0
              assign cro_current_subscribable = true
            endif

            comment
              The free-shipping threshold and flat shipping cost are set on the variant
              picker block, but the purchase widget's script needs them too and sits in a
              different block. Hoisted to section scope so both read one value. Held apart,
              a pack card could say an order ships free while the line directly beneath the
              price still added shipping to it.
            endcomment
            assign cro_ship_threshold = 85
            assign cro_ship_cost = 8
            for b in section.blocks
              if b.type == 'variant_picker'
                assign cro_ship_threshold = b.settings.free_ship_threshold | default: 70
                assign cro_ship_cost = b.settings.ship_cost | default: 8
                break
              endif
            endfor
          -%}

          {%- assign first_app_seen = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'text' -%}
                {%- comment -%} Product category pill badge {%- endcomment -%}
                {%- if product.metafields.custom.product_tagline != blank -%}
                  <div class="cro-info-panel__tagline" {{ block.shopify_attributes }}>
                    <span class="cro-product-badge">
                      {{- product.metafields.custom.product_tagline -}}
                    </span>
                  </div>
                {%- endif -%}

              {%- when 'title' -%}
                {%- comment -%} Split title: first word italic, rest bold {%- endcomment -%}
                {%- assign title_first = product.title | split: ' ' | first -%}
                {%- assign title_rest  = product.title | remove_first: title_first | lstrip -%}
                <div class="cro-info-panel__title" {{ block.shopify_attributes }}>
                  <h1 class="cro-heading cro-product-title">
                    <em>{{ title_first | escape }}</em>
                    {%- if title_rest != blank %} <strong>{{ title_rest | escape }}</strong>{%- endif -%}
                  </h1>
                  {%- if product.type != blank -%}
                    <p class="cro-product-type">{{ product.type }}</p>
                  {%- endif -%}
                </div>

              {%- when 'short_description' -%}
                {%- comment -%} Short description with Read More / Read Less toggle {%- endcomment -%}
                {%- assign short_desc = product.metafields.custom.custom_description -%}
                {%- if short_desc == blank -%}
                  {%- assign short_desc = product.description | strip_html | truncatewords: 30 -%}
                {%- endif -%}
                {%- if short_desc != blank -%}
                  <div class="cro-info-panel__short-desc" {{ block.shopify_attributes }}>
                    <p class="cro-short-desc">{{ short_desc }}</p>
                    {%- if product.description != blank -%}
                      <div class="cro-desc-full rte" id="CroDescFull-{{ section.id }}" aria-hidden="true">
                        {{ product.description }}
                      </div>
                      {%- unless block.settings.hide_read_more -%}
                      <button
                        class="cro-read-more-btn"
                        id="CroReadMoreBtn-{{ section.id }}"
                        aria-expanded="false"
                        aria-controls="CroDescFull-{{ section.id }}"
                        data-label="{{ block.settings.read_more_label | default: 'Read More' | escape }}"
                        type="button"
                      >
                        <span class="cro-read-more-btn__text">{{ block.settings.read_more_label | default: 'Read More' }}</span>
                        <svg class="cro-read-more-btn__icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                          <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      {%- endunless -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'benefit_pills' -%}
                {%- comment -%} Benefit pills — per-product metafields first, block settings as fallback {%- endcomment -%}
                {%- assign mf_p1t = product.metafields.cro.pill_1_text.value -%}
                {%- assign mf_p2t = product.metafields.cro.pill_2_text.value -%}
                {%- assign mf_p3t = product.metafields.cro.pill_3_text.value -%}
                {%- assign mf_p4t = product.metafields.cro.pill_4_text.value -%}
                {%- if mf_p1t != blank or mf_p2t != blank or mf_p3t != blank or mf_p4t != blank -%}
                  <div class="cro-benefit-pills" {{ block.shopify_attributes }}>
                    {%- if mf_p1t != blank -%}
                      <span class="cro-benefit-pill">
                        {%- assign mf_p1i = product.metafields.cro.pill_1_icon.value -%}
                        {%- if mf_p1i != blank -%}<span class="cro-benefit-pill__icon" aria-hidden="true">{{ mf_p1i }}</span>{%- endif -%}
                        {{ mf_p1t }}
                      </span>
                    {%- endif -%}
                    {%- if mf_p2t != blank -%}
                      <span class="cro-benefit-pill">
                        {%- assign mf_p2i = product.metafields.cro.pill_2_icon.value -%}
                        {%- if mf_p2i != blank -%}<span class="cro-benefit-pill__icon" aria-hidden="true">{{ mf_p2i }}</span>{%- endif -%}
                        {{ mf_p2t }}
                      </span>
                    {%- endif -%}
                    {%- if mf_p3t != blank -%}
                      <span class="cro-benefit-pill">
                        {%- assign mf_p3i = product.metafields.cro.pill_3_icon.value -%}
                        {%- if mf_p3i != blank -%}<span class="cro-benefit-pill__icon" aria-hidden="true">{{ mf_p3i }}</span>{%- endif -%}
                        {{ mf_p3t }}
                      </span>
                    {%- endif -%}
                    {%- if mf_p4t != blank -%}
                      <span class="cro-benefit-pill">
                        {%- assign mf_p4i = product.metafields.cro.pill_4_icon.value -%}
                        {%- if mf_p4i != blank -%}<span class="cro-benefit-pill__icon" aria-hidden="true">{{ mf_p4i }}</span>{%- endif -%}
                        {{ mf_p4t }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  {%- assign has_pill = false -%}
                  {%- if block.settings.pill_1_text != blank or block.settings.pill_2_text != blank
                       or block.settings.pill_3_text != blank or block.settings.pill_4_text != blank -%}
                    {%- assign has_pill = true -%}
                  {%- endif -%}
                  {%- if has_pill -%}
                    <div class="cro-benefit-pills" {{ block.shopify_attributes }}>
                      {%- for i in (1..4) -%}
                        {%- assign pill_icon = 'pill_' | append: i | append: '_icon' -%}
                        {%- assign pill_text = 'pill_' | append: i | append: '_text' -%}
                        {%- if block.settings[pill_text] != blank -%}
                          <span class="cro-benefit-pill">
                            {%- if block.settings[pill_icon] != blank -%}
                              <span class="cro-benefit-pill__icon" aria-hidden="true">{{ block.settings[pill_icon] }}</span>
                            {%- endif -%}
                            {{ block.settings[pill_text] }}
                          </span>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}

              {%- when '@app' -%}
                {%- unless first_app_seen -%}
                  <div class="cro-info-panel__app-block cro-review-inline-row" {{ block.shopify_attributes }}>
                    {% render block %}
                    <span class="cro-rating-verified">
                      <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      Verified
                    </span>
                  </div>
                  {%- assign first_app_seen = true -%}
                {%- else -%}
                  <div class="cro-info-panel__app-block" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
                {%- endunless -%}

              {%- when 'price' -%}
                <div
                  class="cro-info-panel__price"
                  id="CroPrice-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}

                  {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="cro-info-panel__tax caption rte">
                      {%- if shop.taxes_included -%}
                        {{ 'products.product.include_taxes' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                <div class="cro-info-panel__variants" {{ block.shopify_attributes }}>
                  {%- assign variant_label = block.settings.variant_label | default: 'Choose Pack Size' -%}
                  <span class="cro-label cro-label--section">{{ variant_label }}</span>

                  {%- unless product.has_only_default_variant -%}
                    {%- if block.settings.picker_type == 'button' -%}
                      <variant-radios
                        class="no-js-hidden cro-variant-row"
                        data-section="{{ section.id }}"
                        data-url="{{ product.url }}"
                      >
                        {%- comment -%}
                          Pack cards render only for single-option products, where each
                          option value maps 1:1 to a variant (so price / availability /
                          per-bottle are resolvable). Multi-option products keep the
                          original pill layout.
                        {%- endcomment -%}
                        {%- assign use_pack_cards = false -%}
                        {%- if cro_new_ux and block.settings.pack_cards != false and product.options_with_values.size == 1 -%}
                          {%- assign use_pack_cards = true -%}
                        {%- endif -%}
                        {%- assign ship_threshold = cro_ship_threshold -%}
                        {%- assign ship_cost = cro_ship_cost -%}
                        {%- assign ship_threshold_cents = ship_threshold | times: 100 -%}

                        {%- comment -%}
                          Badges follow price, not variant order. Shopify appends newly created
                          variants to the end of the list, so a 6-pack added after a 12-pack would
                          otherwise take "Best value" while the 12-pack took "Start here". Cheapest
                          pack gets the starter badge, dearest gets the value badge, whatever order
                          the variants happen to sit in. If every pack costs the same neither badge
                          is shown, since there is no smallest or largest to point at.
                        {%- endcomment -%}
                        {%- liquid
                          assign cro_pack_min_id = nil
                          assign cro_pack_max_id = nil
                          if use_pack_cards
                            for v in product.variants
                              if forloop.first
                                assign cro_pack_min_id = v.id
                                assign cro_pack_max_id = v.id
                                assign cro_pack_min_price = v.price
                                assign cro_pack_max_price = v.price
                              else
                                if v.price < cro_pack_min_price
                                  assign cro_pack_min_price = v.price
                                  assign cro_pack_min_id = v.id
                                endif
                                if v.price > cro_pack_max_price
                                  assign cro_pack_max_price = v.price
                                  assign cro_pack_max_id = v.id
                                endif
                              endif
                            endfor
                          endif
                        -%}

                        {%- for option in product.options_with_values -%}
                          <fieldset class="js product-form__input">
                            <legend class="cro-label">{{ option.name }}</legend>
                            <div class="{% if use_pack_cards %}cro-variant-row--cards{% else %}cro-variant-row{% endif %}">
                              {%- for value in option.values -%}
                                {%- liquid
                                  assign pack_variant = nil
                                  if use_pack_cards
                                    for v in product.variants
                                      if v.title == value
                                        assign pack_variant = v
                                        break
                                      endif
                                    endfor
                                  endif
                                -%}
                                <input
                                  type="radio"
                                  id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                  name="{{ option.name }}"
                                  value="{{ value | escape }}"
                                  form="{{ product_form_id }}"
                                  class="visually-hidden"
                                  {% if option.selected_value == value %}checked{% endif %}
                                  {% if pack_variant and pack_variant.available == false %}disabled{% endif %}
                                >
                                {%- if pack_variant -%}
                                  {%- liquid
                                    assign bottles = value | split: ' ' | first | times: 1
                                    assign per_bottle = 0
                                    if bottles > 0
                                      assign per_bottle = pack_variant.price | times: 1.0 | divided_by: bottles | round
                                    endif
                                    assign ships_free = false
                                    if pack_variant.price >= ship_threshold_cents
                                      assign ships_free = true
                                    endif
                                    assign badge_text = ''
                                    assign badge_kind = ''
                                    if option.values.size > 1 and cro_pack_min_id != cro_pack_max_id
                                      if pack_variant.id == cro_pack_min_id
                                        assign badge_text = block.settings.badge_first | default: 'Start here'
                                        assign badge_kind = 'start'
                                      elsif pack_variant.id == cro_pack_max_id
                                        assign badge_text = block.settings.badge_last | default: 'Best value'
                                        assign badge_kind = 'value'
                                      endif
                                    endif
                                    comment
                                      An unavailable pack takes over the badge slot: "Sold out" replaces
                                      "Best value" rather than sitting alongside it, so the card cannot
                                      advertise a pack that cannot be bought.
                                    endcomment
                                    if pack_variant.available == false
                                      assign badge_text = block.settings.soldout_badge | default: 'Sold out'
                                      assign badge_kind = 'out'
                                    endif
                                  -%}
                                  <label
                                    for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                    class="cro-pack-card{% if pack_variant.available == false %} cro-pack-card--out{% endif %}{% if option.selected_value == value %} is-active{% endif %}"
                                  >
                                    {%- if badge_text != blank -%}
                                      <span class="cro-pack-card__badge cro-pack-card__badge--{{ badge_kind }}">{{ badge_text }}</span>
                                    {%- endif -%}
                                    <span class="cro-pack-card__name">{{ value }}</span>
                                    <span class="cro-pack-card__price">{{ pack_variant.price | money_without_trailing_zeros }}</span>
                                    <span class="cro-pack-card__sub">
                                      {%- if per_bottle > 0 -%}{{ per_bottle | money }} {{ block.settings.per_bottle_suffix | default: '/ bottle' }} · {% endif -%}
                                      {%- if ships_free -%}
                                        {{ block.settings.ships_free_text | default: 'delivered, ships free' }}
                                      {%- else -%}
                                        + ${{ ship_cost }} {{ block.settings.ship_text | default: 'shipping' }}
                                      {%- endif -%}
                                    </span>
                                    {%- comment -%}
                                      Sold out is shown on the badge only — the lower status
                                      line is deliberately omitted so the card doesn't say it
                                      twice. The badge slot is taken over above.
                                    {%- endcomment -%}
                                    {%- unless pack_variant.available == false -%}
                                      <span class="cro-pack-card__foot cro-pack-card__foot--sel">✓ {{ block.settings.selected_text | default: 'Selected' }}</span>
                                      <span class="cro-pack-card__foot cro-pack-card__foot--switch">{{ block.settings.switch_text | default: 'Select' }}</span>
                                    {%- endunless -%}
                                  </label>
                                {%- else -%}
                                  <label
                                    for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                    class="cro-variant-btn{% if option.selected_value == value %} is-active{% endif %}"
                                  >
                                    {{ value }}
                                  </label>
                                {%- endif -%}
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- endfor -%}
                        <script data-cst_variant="data" type="application/json">
                          {{ product.variants | json }}
                        </script>
                      </variant-radios>
                      {%- assign hint_has_plans = product.selected_or_first_available_variant.selling_plan_allocations.size | default: 0 -%}
                      {%- if product.tags contains 'no-subscription' -%}{%- assign hint_has_plans = 0 -%}{%- endif -%}
                      {%- comment -%}
                        [pack] is filled in with the pack that can actually be subscribed to,
                        so this line cannot name the wrong pack. These templates are copied
                        product to product, and a hardcoded pack name travels with the copy —
                        the Action Shot template arrived saying "15 packs" because it began
                        life as a 60 ml one.
                      {%- endcomment -%}
                      {%- comment -%}
                        Also hidden when no pack on the product can be subscribed to. There is
                        nothing for [pack] to name in that case, and the sentence would render
                        with a hole where the pack should be.
                      {%- endcomment -%}
                      <p id="CroNoSubHint-{{ section.id }}" class="cro-variant-nosub-hint" {% if hint_has_plans > 0 or cro_sub_count == 0 %}hidden{% endif %}>{{ block.settings.nosub_hint | default: 'One-time purchase only · Subscription available on the [pack] only' | replace: '[pack]', cro_sub_labels }}</p>
                    {%- else -%}
                      <variant-selects
                        class="no-js-hidden"
                        data-section="{{ section.id }}"
                        data-url="{{ product.url }}"
                      >
                        {%- for option in product.options_with_values -%}
                          <div class="product-form__input product-form__input--dropdown">
                            <label class="cro-label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                              {{ option.name }}
                            </label>
                            <div class="select">
                              <select
                                id="Option-{{ section.id }}-{{ forloop.index0 }}"
                                class="select__select"
                                name="options[{{ option.name | escape }}]"
                                form="{{ product_form_id }}"
                              >
                                {%- for value in option.values -%}
                                  <option
                                    value="{{ value | escape }}"
                                    {% if option.selected_value == value %}selected="selected"{% endif %}
                                  >{{ value }}</option>
                                {%- endfor -%}
                              </select>
                              {% render 'icon-caret' %}
                            </div>
                          </div>
                        {%- endfor -%}
                        <script data-cst_variant="data" type="application/json">
                          {{ product.variants | json }}
                        </script>
                      </variant-selects>
                    {%- endif -%}

                    {%- comment -%} Pack customiser for bundle products {%- endcomment -%}
                    {%- if product.id == 5384322908328
                         or product.id == 8723492995240
                         or product.id == 7399079248040 -%}
                      {%- render 'cro-pack-customiser', product: product, form_id: product_form_id -%}
                    {%- endif -%}
                  {%- endunless -%}
                </div>

              {%- when 'buy_buttons' -%}
                <div class="cro-info-panel__buy" {{ block.shopify_attributes }}>
                  <product-form class="product-form">
                    <div class="product-form__error-message-wrapper" role="alert" hidden>
                      {% render 'svg_error_icon' %}
                      <span class="product-form__error-message"></span>
                    </div>

                    {%- form 'product',
                          product,
                          id: product_form_id,
                          class: 'form',
                          novalidate: 'novalidate',
                          data-type: 'add-to-cart-form',
                          data-productid: product.id -%}

                      {%- comment -%} ReCharge subscription snippet {%- endcomment -%}
                      {%- if product.available -%}
                        {% render 'subscription-product' with product as product %}
                      {%- endif -%}

                      <input
                        type="hidden"
                        name="id"
                        data-productid="{{ product.id }}"
                        value="{{ product.selected_or_first_available_variant.id }}"
                        disabled
                      >

                      <div class="cro-info-panel__cta-wrap">
                        <button
                          type="submit"
                          name="add"
                          class="cro-btn cro-btn--primary cro-atc-btn"
                          id="CroATC-{{ section.id }}"
                          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                        >
                          <span class="cro-atc-btn__label">
                            {%- if product.selected_or_first_available_variant.available -%}
                              {{ 'products.product.add_to_cart' | t }}
                              —
                              <span class="cro-atc-btn__price">
                                {{ product.selected_or_first_available_variant.price | money }}
                              </span>
                            {%- else -%}
                              {{ 'products.product.sold_out' | t }}
                            {%- endif -%}
                          </span>
                          <div class="loading-overlay__spinner hidden">
                            {% render 'svg_loading_spinner' %}
                          </div>
                        </button>

                        {%- if block.settings.show_dynamic_checkout and product.selling_plan_groups == empty -%}
                          <div class="cro-info-panel__dynamic-checkout">
                            {{ form | payment_button }}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endform -%}
                  </product-form>

                  {%- comment -%}
                    Sold-out notice, under the CTA. Reassures that the customer's
                    own selection was left alone — the approved behaviour is never
                    to switch packs silently.
                  {%- endcomment -%}
                  {%- if cro_new_ux and cro_soldout_labels != blank -%}
                    <p class="cro-pw__soldout-note" role="status">
                      {%- if cro_sub_blocked -%}
                        {%- assign note_tpl = block.settings.soldout_note_sub | default: 'The [pack] is currently sold out, so new subscriptions are temporarily unavailable. Your selection hasn’t changed.' -%}
                      {%- else -%}
                        {%- assign note_tpl = block.settings.soldout_note | default: '[pack] is currently sold out. Other pack sizes are still available.' -%}
                      {%- endif -%}
                      {{ note_tpl | replace: '[pack]', cro_soldout_labels }}
                    </p>
                  {%- endif -%}

                  {%- comment -%}
                    Sample Pack entry point. Falls back to the sample-pack product
                    when no URL is set, and never renders on the Sample Pack itself
                    — offering a customer the product they are already looking at.
                  {%- endcomment -%}
                  {%- liquid
                    assign sample_url = block.settings.sample_url
                    if sample_url == blank
                      assign sample_product = all_products['sample-pack']
                      if sample_product != empty
                        assign sample_url = sample_product.url
                      endif
                    endif
                    assign sample_label = block.settings.sample_label | default: 'Try the Sample Pack.'
                  -%}
                  {%- if cro_new_ux and sample_url != blank and product.handle != 'sample-pack' and sample_label != blank -%}
                    <p class="cro-sample-link">
                      {%- assign sample_lead = block.settings.sample_lead | default: 'New to GOJU?' -%}
                      {%- if sample_lead != blank -%}<span class="cro-sample-link__lead">{{ sample_lead }}</span> {% endif -%}
                      <a href="{{ sample_url }}" data-cro-sample-link>{{ sample_label }}</a>
                    </p>
                  {%- endif -%}
                </div>

              {%- when 'mini_trust' -%}
                <div class="cro-mini-trust-bar" {{ block.shopify_attributes }}>
                  {%- assign items = 'item_1,item_2,item_3,item_4' | split: ',' -%}
                  {%- for item in items -%}
                    {%- assign icon_key = 'icon_' | append: forloop.index -%}
                    {%- assign text_key = 'text_' | append: forloop.index -%}
                    {%- if block.settings[text_key] != blank -%}
                      <div class="cro-mini-trust-item">
                        {%- if block.settings[icon_key] != blank -%}
                          <span class="cro-mini-trust-icon" aria-hidden="true">{{ block.settings[icon_key] }}</span>
                        {%- endif -%}
                        <span>{{ block.settings[text_key] }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'purchase_widget' -%}
                {%- comment -%} Custom CRO purchase widget — hides default ReCharge UI {%- endcomment -%}
                {%- assign pw_price    = product.selected_or_first_available_variant.price -%}
                {%- assign pw_discount = block.settings.discount_percent | plus: 0 -%}
                {%- assign no_sub = false -%}
                {%- if product.tags contains 'no-subscription' -%}{%- assign no_sub = true -%}{%- endif -%}
                <div
                  class="cro-pw"
                  id="CroPW-{{ section.id }}"
                  data-price="{{ pw_price }}"
                  data-discount="{{ pw_discount }}"
                  data-section="{{ section.id }}"
                  data-no-sub="{{ no_sub }}"
                  data-variant-has-plans="{%- if no_sub -%}0{%- else -%}{{ product.selected_or_first_available_variant.selling_plan_allocations.size | default: 0 }}{%- endif -%}"
                  data-sub-elsewhere="{% if cro_sub_exists and cro_sub_blocked == false %}true{% else %}false{% endif %}"
                  data-new-ux="{% if cro_new_ux %}true{% else %}false{% endif %}"
                  data-per-shot-label="{{ block.settings.per_shot_label | escape }}"
                  data-free-ship-threshold="{{ cro_ship_threshold }}"
                  data-ship-cost="{{ cro_ship_cost }}"
                  {{ block.shopify_attributes }}
                >
                  {%- comment -%} One-time / Subscribe toggle — hidden for no-subscription products {%- endcomment -%}
                  {%- unless no_sub -%}
                  <div class="cro-pw__toggle{% if cro_sub_blocked %} cro-pw__toggle--sub-blocked{% endif %}">
                    <button class="cro-pw__tog-btn{% if cro_sub_blocked %} is-active{% endif %}" data-mode="once" type="button">{{ block.settings.label_onetime }}</button>
                    <button
                      class="cro-pw__tog-btn{% unless cro_sub_blocked %} is-active{% endunless %}{% if cro_sub_blocked %} is-blocked{% endif %}"
                      data-mode="sub"
                      type="button"
                      {% if cro_sub_blocked %}disabled aria-disabled="true"{% endif %}
                    >
                      {{- block.settings.label_sub }}{% if pw_discount > 0 %} {{ pw_discount }}%{% endif %}
                      {%- comment -%}
                        When exactly one pack is subscribable, name it — the customer
                        should know before clicking that Subscribe implies a different
                        pack. With two or more subscribable packs there is nothing to
                        disambiguate, so the suffix is omitted.
                      {%- endcomment -%}
                      {%- if cro_sub_blocked -%}
                        {{ ' — ' }}{{ block.settings.sub_unavailable_suffix | default: 'unavailable' }}
                      {%- elsif cro_new_ux and cro_sub_count == 1 and product.variants.size > 1 -%}
                        {%- assign only_suffix = block.settings.sub_only_suffix | default: '— [pack] only' -%}
                        {{ ' ' }}{{ only_suffix | replace: '[pack]', cro_sub_labels }}
                      {%- endif -%}
                    </button>
                  </div>
                  {%- comment -%}
                    One hint line under the toggle, three states, matching the
                    approved prototype:
                      1. subscription blocked — no subscribable pack in stock
                      2. one subscribable pack and the customer is not on it —
                         warns that choosing Subscribe will move them, BEFORE
                         they click, so the switch is never a surprise
                      3. more than one subscribable pack — nothing to
                         disambiguate, so a plain benefit line
                    The line is always present when there is something to say,
                    as in the approved prototype — it is not hidden once the
                    customer is on the subscribable pack.

                    The switch wording needs a pack to switch FROM, so a
                    single-variant product falls through to the general benefit
                    line. Action Shot shows that today and will show the switch
                    wording automatically once the 6-pack exists.
                  {%- endcomment -%}
                  {%- if cro_new_ux -%}
                    {%- liquid
                      assign cro_hint = ''
                      if cro_sub_blocked
                        assign hint_tpl = block.settings.sub_blocked_hint | default: 'Subscription is unavailable while the [pack] is out of stock.'
                        assign cro_hint = hint_tpl | replace: '[pack]', cro_sub_labels
                      elsif cro_sub_count == 1 and product.variants.size > 1
                        assign hint_tpl = block.settings.sub_switch_hint | default: 'Selecting Subscribe switches to the [pack]: 10% off + free shipping.'
                        assign cro_hint = hint_tpl | replace: '[pack]', cro_sub_labels
                      elsif cro_sub_count > 0
                        assign cro_hint = block.settings.sub_general_hint | default: 'Subscribe saves 10% on every order and always ships free.'
                      endif
                    -%}
                    {%- if cro_hint != blank -%}
                      <p
                        class="cro-pw__sub-blocked-hint"
                        id="CroPWHintLine-{{ section.id }}"
                        data-persist="{% if cro_sub_blocked %}true{% else %}false{% endif %}"
                      >{{ cro_hint }}</p>
                    {%- endif -%}
                  {%- endif -%}
                  {%- comment -%}
                    Announced when choosing Subscribe moved the customer to a
                    different pack. role="status" so screen readers hear it, since
                    the change happens away from where they clicked.
                  {%- endcomment -%}
                  <div
                    class="cro-pw__switch-note"
                    id="CroPWSwitchNote-{{ section.id }}"
                    role="status"
                    data-template="{{ block.settings.switch_note | default: 'Subscriptions are available on the [pack]. We’ve updated your selection.' | escape }}"
                    hidden
                  ></div>
                  {%- endunless -%}

                  {%- comment -%}
                    Deep link landed on a sold-out pack. The customer is moved to
                    an available one and told so — never switched silently.
                  {%- endcomment -%}
                  {%- if cro_new_ux -%}
                    <div
                      class="cro-pw__switch-note cro-pw__switch-note--soldout"
                      id="CroPWSoldOutSwitch-{{ section.id }}"
                      role="status"
                      data-template="{{ block.settings.soldout_switch_note | default: 'The [pack] is sold out. We’ve selected the [available].' | escape }}"
                      data-active="{% if cro_deeplink_soldout %}true{% else %}false{% endif %}"
                      data-soldout-pack="{{ cro_selected_variant.title | escape }}"
                      data-available-pack="{{ cro_first_available | escape }}"
                      hidden
                    ></div>

                    {%- comment -%} Nothing can be purchased at all. {%- endcomment -%}
                    {%- unless cro_any_available -%}
                      <p class="cro-pw__all-soldout" role="status">
                        {%- assign all_out = block.settings.all_soldout_note | default: '[product] is currently sold out.' -%}
                        {{ all_out | replace: '[product]', product.title }}
                      </p>
                    {%- endunless -%}
                  {%- endif -%}

                  {%- comment -%} Price block {%- endcomment -%}
                  <div class="cro-pw__price-main" id="CroPWPrice-{{ section.id }}"></div>
                  <div class="cro-pw__price-was" id="CroPWWas-{{ section.id }}"></div>
                  <div class="cro-pw__saving-pill" id="CroPWSaving-{{ section.id }}"></div>
                  <div class="cro-pw__price-note" id="CroPWNote-{{ section.id }}"></div>
                  <div class="cro-pw__per-shot" id="CroPWPerShot-{{ section.id }}" hidden></div>

                  {%- unless no_sub -%}
                  {%- comment -%} Subscription perks {%- endcomment -%}
                  <ul class="cro-pw__perks" id="CroPWPerks-{{ section.id }}">
                    {%- if block.settings.perk_1 != blank -%}<li><span class="cro-pw__perk-dot"></span>{{ block.settings.perk_1 }}</li>{%- endif -%}
                    {%- if block.settings.perk_2 != blank -%}<li><span class="cro-pw__perk-dot"></span>{{ block.settings.perk_2 }}</li>{%- endif -%}
                    {%- if block.settings.perk_3 != blank -%}<li><span class="cro-pw__perk-dot"></span>{{ block.settings.perk_3 }}</li>{%- endif -%}
                  </ul>

                  {%- comment -%} Frequency selector {%- endcomment -%}
                  <div class="cro-pw__freq" id="CroPWFreq-{{ section.id }}">
                    <div class="cro-pw__freq-label">{{ block.settings.freq_label }}</div>
                    <div class="cro-pw__freq-btns">
                      {%- for group in product.selling_plan_groups -%}
                        {%- for plan in group.selling_plans -%}
                          <button class="cro-pw__freq-btn{% if forloop.first and forloop.parentloop.first %} is-active{% endif %}" data-plan-id="{{ plan.id }}" data-hint="{{ plan.description }}" type="button">{%- assign tw = plan.name | truncatewords: 2, '' | split: ' ' -%}{{ tw.first }} {{ tw.last | capitalize }}s</button>
                        {%- endfor -%}
                      {%- endfor -%}
                    </div>
                    <div class="cro-pw__freq-hint" id="CroPWHint-{{ section.id }}"></div>
                  </div>

                  {%- comment -%} One-time nudge — hidden for no-plan variants {%- endcomment -%}
                  <div class="cro-pw__onetime-note" id="CroPWOnetimeNote-{{ section.id }}" hidden>
                    {{ block.settings.onetime_note }}
                  </div>

                  {%- comment -%} No-plan variant upsell — shown instead of onetime nudge {%- endcomment -%}
                  {%- assign pw_v_has_plans = product.selected_or_first_available_variant.selling_plan_allocations.size | default: 0 -%}
                  {%- comment -%} Upsell only shows for per-variant no-sub (not when whole product is tagged no-subscription) {%- endcomment -%}
                  <div class="cro-pw__nosub-upsell" id="CroPWNoSubUpsell-{{ section.id }}" {% if pw_v_has_plans > 0 or no_sub or cro_sub_count == 0 %}hidden{% endif %}>
                    <a href="#" class="cro-pw__nosub-link" id="CroPWNoSubLink-{{ section.id }}">{{ block.settings.nosub_upsell | default: '[pack] with Subscribe &amp; Save — save 10% with free shipping always.' | replace: '[pack]', cro_sub_labels }}</a>
                  </div>

                  {%- comment -%} Cancel reassurance {%- endcomment -%}
                  {%- comment -%}
                    Guarded: the note carries a top border, so an empty setting
                    would leave a stray rule across the widget.
                  {%- endcomment -%}
                  {%- if block.settings.cancel_note != blank -%}
                    <div class="cro-pw__cancel-note" id="CroPWCancel-{{ section.id }}">{{ block.settings.cancel_note }}</div>
                  {%- endif -%}
                  {%- endunless -%}
                </div>

              {%- when 'accordion_item' -%}
                {%- comment -%} Per-product metafield override for accordion content {%- endcomment -%}
                {%- assign acc_mf_key = block.settings.metafield_key -%}
                {%- assign acc_title = block.settings.title -%}
                {%- assign acc_content = block.settings.content -%}
                {%- if acc_mf_key != blank -%}
                  {%- assign acc_title_key = acc_mf_key | append: '_title' -%}
                  {%- assign acc_mf_title = product.metafields.cro[acc_title_key].value -%}
                  {%- assign acc_mf_content = product.metafields.cro[acc_mf_key].value -%}
                  {%- if acc_mf_title != blank -%}{%- assign acc_title = acc_mf_title -%}{%- endif -%}
                  {%- if acc_mf_content != blank -%}{%- assign acc_content = acc_mf_content -%}{%- endif -%}
                {%- endif -%}
                {%- comment -%} Inline accordion row — group all adjacent items in one wrapper {%- endcomment -%}
                {%- assign is_first_accordion = true -%}
                {%- assign prev_index = forloop.index0 | minus: 1 -%}
                {%- if prev_index >= 0 -%}
                  {%- assign prev_block = section.blocks[prev_index] -%}
                  {%- if prev_block.type == 'accordion_item' -%}
                    {%- assign is_first_accordion = false -%}
                  {%- endif -%}
                {%- endif -%}
                {%- assign next_index = forloop.index0 | plus: 1 -%}
                {%- assign is_last_accordion = true -%}
                {%- if next_index < section.blocks.size -%}
                  {%- assign next_block = section.blocks[next_index] -%}
                  {%- if next_block.type == 'accordion_item' -%}
                    {%- assign is_last_accordion = false -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if is_first_accordion -%}<div class="cro-panel-accordion">{%- endif -%}
                <details class="cro-panel-acc-item" {{ block.shopify_attributes }}>
                  <summary class="cro-panel-acc-item__head">
                    <span class="cro-panel-acc-item__title">{{ acc_title }}</span>
                    <svg class="cro-panel-acc-item__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 6L8 11L13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <div class="cro-panel-acc-item__body rte">
                    {{ acc_content }}
                  </div>
                </details>
                {%- if is_last_accordion -%}</div>{%- endif -%}

              {%- when 'shipping_info' -%}
                <div class="cro-info-panel__shipping cro-trust-bar" {{ block.shopify_attributes }}>
                  {%- if block.settings.free_shipping_icon != blank -%}
                    <div class="cro-trust-item">
                      <img
                        src="{{ block.settings.free_shipping_icon | img_url: '32x32' }}"
                        alt=""
                        width="20"
                        height="20"
                        loading="lazy"
                        class="cro-trust-icon"
                      >
                      <span>{{ block.settings.free_shipping_text }}</span>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.happiness_text_icon != blank -%}
                    <div class="cro-trust-item">
                      <img
                        src="{{ block.settings.happiness_text_icon | img_url: '32x32' }}"
                        alt=""
                        width="20"
                        height="20"
                        loading="lazy"
                        class="cro-trust-icon"
                      >
                      <span>{{ block.settings.happiness_text }}</span>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'trust' -%}
                <div class="cro-info-panel__trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.trust_text != blank -%}
                    <p class="cro-label">{{ block.settings.trust_text }}</p>
                  {%- endif -%}
                  {% render 'product_trust' %}
                </div>

              {%- when 'stats_row' -%}
                <div class="cro-info-panel__stats-row cro-stats-row" {{ block.shopify_attributes }}>
                  {%- for i in (1..3) -%}
                    {%- assign num_key   = 'stat_' | append: i | append: '_number' -%}
                    {%- assign label_key = 'stat_' | append: i | append: '_label' -%}
                    {%- if block.settings[num_key] != blank -%}
                      <div class="cro-stat-item">
                        <span class="cro-stat-item__number">{{ block.settings[num_key] }}</span>
                        <span class="cro-stat-item__label">{{ block.settings[label_key] }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'description' -%}
                {%- comment -%} Full description handled by Read More in short_description block {%- endcomment -%}

              {%- when 'scroll_headlines' -%}
                <nav class="cro-info-panel__scroll-nav" aria-label="Product sections" {{ block.shopify_attributes }}>
                  {%- if block.settings.desc != blank -%}
                    <a href="#{{ block.settings.desc_id | handleize }}" class="cro-scroll-link">
                      {{ block.settings.desc }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.whats_in_it != blank -%}
                    <a href="#{{ block.settings.whats_in_it_id | handleize }}" class="cro-scroll-link">
                      {{ block.settings.whats_in_it }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.subscription != blank -%}
                    <a href="#{{ block.settings.subscription_id | handleize }}" class="cro-scroll-link">
                      {{ block.settings.subscription }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.reviews != blank -%}
                    <a href="#{{ block.settings.reviews_id | handleize }}" class="cro-scroll-link">
                      {{ block.settings.reviews }}
                    </a>
                  {%- endif -%}
                </nav>

              {%- when 'collapsible_tab' -%}
                <div class="cro-info-panel__accordion product__accordion" {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h2 class="h4 accordion__title">
                          {{ block.settings.heading | default: block.settings.page.title }}
                        </h2>
                      </div>
                      {% render 'icon-caret' %}
                    </summary>
                    <div class="accordion__content rte">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>

              {%- when 'share' -%}
                <share-button
                  id="Share-{{ section.id }}"
                  class="share-button"
                  {{ block.shopify_attributes }}
                >
                  <button class="share-button__button hidden">
                    {% render 'icon-share' %}
                    {{ block.settings.share_label | escape }}
                  </button>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary class="share-button__button">
                      {% render 'icon-share' %}
                      {{ block.settings.share_label | escape }}
                    </summary>
                    <div class="share-button__fallback motion-reduce">
                      <div class="field">
                        <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status"></span>
                        <input
                          type="text"
                          class="field__input"
                          id="url"
                          value="{{ product.selected_variant.url | default: product.url | prepend: request.origin }}"
                          placeholder="{{ 'general.share.share_url' | t }}"
                          onclick="this.select();"
                          readonly
                        >
                        <label class="field__label" for="url">{{ 'general.share.share_url' | t }}</label>
                      </div>
                      <button class="share-button__close hidden no-js-hidden">
                        {% render 'icon-close' %}
                        <span class="visually-hidden">{{ 'general.share.close' | t }}</span>
                      </button>
                      <button class="share-button__copy no-js-hidden">
                        {% render 'icon-clipboard' %}
                        <span class="visually-hidden">{{ 'general.share.copy_to_clipboard' | t }}</span>
                      </button>
                    </div>
                  </details>
                </share-button>
                <script src="{{ 'share.js' | asset_url }}" defer="defer"></script>

            {%- endcase -%}
          {%- endfor -%}

        </div>{%- comment -%} /.cro-info-panel__sticky {%- endcomment -%}
      </div>{%- comment -%} /.cro-info-panel {%- endcomment -%}

    </div>{%- comment -%} /.cro-product-hero {%- endcomment -%}
  </div>{%- comment -%} /.cro-container {%- endcomment -%}

  {%- comment -%} Popups for variant modals (kept from original) {%- endcomment -%}
  {% assign popups = section.blocks | where: "type", "popup" %}
  {%- for block in popups -%}
    <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
      <div role="dialog" aria-label="{{ block.settings.text }}" aria-modal="true" class="product-popup-modal__content" tabindex="-1">
        <button id="ModalClose-{{ block.id }}" type="button" class="product-popup-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon-close' %}
        </button>
        <div class="product-popup-modal__content-info">
          <h1 class="h2">{{ block.settings.page.title }}</h1>
          {{ block.settings.page.content }}
        </div>
      </div>
    </modal-dialog>
  {%- endfor -%}

  {%- comment -%} Sticky ATC bar {%- endcomment -%}
  <div
    class="cro-sticky-atc"
    id="CroStickyATC-{{ section.id }}"
    aria-hidden="true"
    aria-live="polite"
  >
    {%- comment -%} Product thumbnail {%- endcomment -%}
    {%- if product.featured_image != blank -%}
      <img
        class="cro-sticky-atc__thumb"
        src="{{ product.featured_image | img_url: '80x80', crop: 'center' }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        width="40"
        height="40"
        loading="lazy"
        id="CroStickyThumb-{{ section.id }}"
      >
    {%- endif -%}

    {%- comment -%} Product info {%- endcomment -%}
    <div class="cro-sticky-atc__info">
      <span class="cro-sticky-atc__name">{{ product.title | escape }}</span>
      {%- unless product.has_only_default_variant -%}
        <span class="cro-sticky-atc__variant" id="CroStickyVariant-{{ section.id }}">
          {{- product.selected_or_first_available_variant.title -}}
        </span>
      {%- endunless -%}
    </div>

    {%- comment -%} Purchase mode toggle — hidden for no-subscription products {%- endcomment -%}
    {%- unless product.tags contains 'no-subscription' -%}
    <div class="cro-sticky-atc__mode" id="CroStickyMode-{{ section.id }}">
      <button class="cro-sticky-atc__mode-btn" data-mode="once" type="button">One-time</button>
      <button class="cro-sticky-atc__mode-btn is-active" data-mode="sub" type="button">Subscribe</button>
    </div>
    {%- endunless -%}

    {%- comment -%} Price {%- endcomment -%}
    <span class="cro-sticky-atc__price" id="CroStickyPrice-{{ section.id }}">
      {{ product.selected_or_first_available_variant.price | money }}
    </span>

    {%- comment -%} Add to cart / Subscribe button {%- endcomment -%}
    <button
      class="cro-sticky-atc__btn"
      id="CroStickyBtn-{{ section.id }}"
      data-form="{{ product_form_id }}"
      data-label-add="Add to Cart"
      data-label-adding="Adding…"
      data-label-added="Added ✓"
      data-label-soldout="{{ 'products.product.sold_out' | t }}"
      {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
    >
      {%- if product.selected_or_first_available_variant.available -%}
        {%- if product.tags contains 'no-subscription' -%}
          Add to Cart
        {%- else -%}
          Subscribe &amp; Save 10%
        {%- endif -%}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>

  {%- comment -%} JS scripts {%- endcomment -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.media.size > 0 -%}
    <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- comment -%} Schema / SEO ld+json {%- endcomment -%}
  {%- liquid
    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if seo_media %}"image": [{{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}],{% endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            {% if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
            "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price": {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "url": {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

</section>

{%- comment -%} ─── Gallery & Sticky ATC JavaScript ─── {%- endcomment -%}
<script>
(function() {
  'use strict';

  // ── Gallery: slide switching ──────────────────────────────────
  function CroGallery(sectionId) {
    var slidesEl  = document.getElementById('CroSlides-' + sectionId);
    var thumbsEl  = document.getElementById('CroThumbs-' + sectionId);
    if (!slidesEl) return;

    var slides = Array.from(slidesEl.querySelectorAll('.cro-gallery__slide'));
    var thumbs = thumbsEl
      ? Array.from(thumbsEl.querySelectorAll('.cro-gallery__thumb'))
      : [];
    var current = 0;

    function goTo(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      if (thumbs[current]) {
        thumbs[current].classList.remove('is-active');
        thumbs[current].setAttribute('aria-selected', 'false');
      }

      current = index;
      slides[current].classList.add('is-active');
      slides[current].setAttribute('aria-hidden', 'false');
      if (thumbs[current]) {
        thumbs[current].classList.add('is-active');
        thumbs[current].setAttribute('aria-selected', 'true');
      }
    }

    // Arrow buttons
    var section = document.getElementById('MainProduct-' + sectionId);
    if (section) {
      section.querySelectorAll('.cro-gallery__arrow').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var dir = parseInt(btn.dataset.dir, 10);
          goTo(current + dir);
        });
      });
    }

    // Thumbnail clicks
    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        goTo(parseInt(thumb.dataset.index, 10));
      });
    });

    // Touch/swipe on main image
    var touchStartX = 0;
    slidesEl.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    slidesEl.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 40) goTo(current + (diff > 0 ? 1 : -1));
    }, { passive: true });

    // Sync with variant change (Shopify variant-radios / variant-selects)
    document.addEventListener('variant:change', function(e) {
      var variant = e.detail && e.detail.variant;
      if (!variant || !variant.featured_media) return;
      var mediaId = String(variant.featured_media.id);
      slides.forEach(function(slide, i) {
        if (slide.querySelector('[data-media-id="' + mediaId + '"]')) goTo(i);
      });
    });
  }

  // ── Sticky ATC ───────────────────────────────────────────────
  function CroStickyATC(sectionId) {
    var bar       = document.getElementById('CroStickyATC-'    + sectionId);
    var anchor    = document.getElementById('CroATC-'          + sectionId);
    var priceEl   = document.getElementById('CroStickyPrice-'  + sectionId);
    var variantEl = document.getElementById('CroStickyVariant-'+ sectionId);
    var thumbEl   = document.getElementById('CroStickyThumb-'  + sectionId);
    var stickyBtn = document.getElementById('CroStickyBtn-'    + sectionId);
    var modeEl    = document.getElementById('CroStickyMode-'   + sectionId);
    var pw        = document.getElementById('CroPW-'           + sectionId);
    if (!bar || !anchor) return;

    // ── 1. Show / hide using IntersectionObserver ──
    // Wait for window.load so images and app widgets have settled layout
    // before we start observing — prevents the flash-on-load on mobile.
    function initVisibility() {
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function(entries) {
          var entry = entries[0];
          // Only show when ATC has scrolled ABOVE the viewport (top < 0).
          // If top > 0 the ATC is still below the fold — don't show yet.
          var show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          bar.classList.toggle('is-visible', show);
          bar.setAttribute('aria-hidden', show ? 'false' : 'true');
        }, { threshold: 0 }).observe(anchor);
      } else {
        var threshold = anchor.getBoundingClientRect().top + window.scrollY + anchor.offsetHeight;
        function checkVisibility() {
          var show = window.scrollY > threshold;
          bar.classList.toggle('is-visible', show);
          bar.setAttribute('aria-hidden', show ? 'false' : 'true');
        }
        window.addEventListener('resize', function() {
          threshold = anchor.getBoundingClientRect().top + window.scrollY + anchor.offsetHeight;
        });
        window.addEventListener('scroll', checkVisibility, { passive: true });
        checkVisibility();
      }
    }

    if (document.readyState === 'complete') {
      initVisibility();
    } else {
      window.addEventListener('load', initVisibility);
    }

    // ── 2. Price helpers ──
    window._croCurrentVariantPrice = {{ product.selected_or_first_available_variant.price }};

    function money(cents) {
      return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
    }
    function getStickyPrice(mode, price) {
      if (!pw || mode !== 'sub') return money(price);
      var disc = parseInt(pw.dataset.discount, 10) || 10;
      return money(Math.round(price * (1 - disc / 100)));
    }

    // ── 3. Mode toggle (One-time / Subscribe) ──
    // Follow the buy box rather than assuming Subscribe. Defaulting to 'sub' was
    // right while every product opened subscribe-first, but under the new
    // experience the buy box opens one-time, and the bar was left advertising
    // "Subscribe & Save 10%" at the subscription price over a one-time buy box.
    // The bar only clicks the form's own submit, so the cart took the one-time
    // price the buy box was showing — the customer saw one number and was
    // charged another.
    // Safe to read here: the widget runs at parse time and initPW has already
    // resolved the toggle, while this runs on DOMContentLoaded.
    function croStickyInitialMode() {
      if (!pw) return 'once';
      if (pw.dataset.noSub === 'true') return 'once';
      // No plan on this pack — one-time is the only thing that can be bought.
      // Checked before the toggle because a hidden toggle keeps its markup state.
      if (pw.dataset.variantHasPlans === '0') return 'once';
      var active = pw.querySelector('.cro-pw__tog-btn.is-active');
      return active && active.dataset.mode === 'sub' ? 'sub' : 'once';
    }
    var stickyMode = croStickyInitialMode();

    function setMode(mode) {
      stickyMode = mode;
      if (modeEl) {
        modeEl.querySelectorAll('.cro-sticky-atc__mode-btn').forEach(function(b) {
          b.classList.toggle('is-active', b.dataset.mode === mode);
        });
      }
      var price = window._croCurrentVariantPrice;
      if (priceEl) priceEl.textContent = getStickyPrice(mode, price);
      if (stickyBtn) stickyBtn.textContent = mode === 'sub' ? 'Subscribe & Save 10%' : stickyBtn.dataset.labelAdd;
      // Mirror to main purchase widget
      if (pw) {
        pw.querySelectorAll('.cro-pw__tog-btn').forEach(function(b) {
          if (b.dataset.mode === mode && !b.classList.contains('is-active')) b.click();
        });
      }
    }

    if (modeEl) {
      modeEl.querySelectorAll('.cro-sticky-atc__mode-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          // setMode mirrors to the main widget with a programmatic .click(),
          // which the auto-switch guard would otherwise reject. This came from
          // a real user, so flag it for the duration of the mirror.
          window._croUserInitiated = true;
          setMode(btn.dataset.mode);
          setTimeout(function() { window._croUserInitiated = false; }, 0);
        });
      });
    }

    // Mirror main PW toggle → sticky
    if (pw) {
      pw.querySelectorAll('.cro-pw__tog-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          stickyMode = btn.dataset.mode;
          if (modeEl) {
            modeEl.querySelectorAll('.cro-sticky-atc__mode-btn').forEach(function(b) {
              b.classList.toggle('is-active', b.dataset.mode === stickyMode);
            });
          }
          if (priceEl) priceEl.textContent = getStickyPrice(stickyMode, window._croCurrentVariantPrice);
          if (stickyBtn) stickyBtn.textContent = stickyMode === 'sub' ? 'Subscribe & Save 10%' : stickyBtn.dataset.labelAdd;
        });
      });
    }

    // Initialise the bar to the mode the buy box actually resolved to. The markup
    // marks Subscribe active because that was the old default, so the classes and
    // the button label have to be re-stated here as well as the price — otherwise
    // the bar keeps advertising a subscription over a one-time buy box.
    // Deliberately not setMode(): that mirrors back into the buy box with a
    // programmatic click, and the bar must follow the buy box, never move it.
    if (modeEl) {
      modeEl.querySelectorAll('.cro-sticky-atc__mode-btn').forEach(function (b) {
        b.classList.toggle('is-active', b.dataset.mode === stickyMode);
      });
    }
    if (stickyBtn && stickyMode !== 'sub' && stickyBtn.dataset.labelAdd) {
      stickyBtn.textContent = stickyBtn.dataset.labelAdd;
    }
    if (priceEl) priceEl.textContent = getStickyPrice(stickyMode, window._croCurrentVariantPrice);

    // ── 4. Variant change ──
    document.addEventListener('variant:change', function(e) {
      var v = e.detail && e.detail.variant;
      if (!v) return;
      window._croCurrentVariantPrice = v.price;
      if (priceEl) priceEl.textContent = getStickyPrice(stickyMode, v.price);
      if (variantEl) variantEl.textContent = v.title !== 'Default Title' ? v.title : '';
      if (thumbEl && v.featured_image) {
        thumbEl.src = v.featured_image.src.replace(/(\.[a-z]+)(\?.*)?$/, '_80x80_crop_center$1$2');
      }
      if (stickyBtn) {
        stickyBtn.disabled = !v.available;
        stickyBtn.textContent = v.available
          ? (stickyMode === 'sub' ? 'Subscribe & Save 10%' : stickyBtn.dataset.labelAdd)
          : stickyBtn.dataset.labelSoldout;
      }
    });

    // ── 5. ATC button click ──
    if (stickyBtn) {
      stickyBtn.addEventListener('click', function() {
        if (stickyBtn.disabled) return;
        var form = document.getElementById(stickyBtn.dataset.form);
        if (!form) return;
        stickyBtn.disabled = true;
        stickyBtn.textContent = stickyBtn.dataset.labelAdding;
        var mainSubmit = form.querySelector('[type="submit"][name="add"]');
        if (mainSubmit) mainSubmit.click();
        var restore = setTimeout(function() {
          stickyBtn.textContent = stickyBtn.dataset.labelAdd;
          stickyBtn.disabled = false;
        }, 3500);
        function onCartUpdate() {
          clearTimeout(restore);
          stickyBtn.textContent = stickyBtn.dataset.labelAdded;
          setTimeout(function() {
            stickyBtn.textContent = stickyBtn.dataset.labelAdd;
            stickyBtn.disabled = false;
          }, 2000);
        }
        document.addEventListener('cart:updated', onCartUpdate, { once: true });
        document.addEventListener('cart:change',  onCartUpdate, { once: true });
      });
    }

  }

  // ── Custom Purchase Widget ────────────────────────────────────
  (function () {
    var pw = document.getElementById('CroPW-{{ section.id }}');
    if (!pw) return;

    var rawPrice    = parseInt(pw.dataset.price, 10);          // price in cents
    var discount    = parseInt(pw.dataset.discount, 10) || 10;
    var defaultFreq = pw.dataset.defaultFreq || '2w';

    var onetimePrice = rawPrice / 100;
    var subPrice     = Math.round(rawPrice * (1 - discount / 100)) / 100;
    var saving       = Math.round((onetimePrice - subPrice) * 100) / 100;
    // Both come from the variant picker's settings, so the pack cards and the lines
    // below the price cannot disagree about shipping. The literals are a last resort
    // for a page rendered without a variant picker block.
    var freeShipThreshold = parseFloat(pw.dataset.freeShipThreshold);
    if (isNaN(freeShipThreshold)) freeShipThreshold = 85;
    var shipCost = parseFloat(pw.dataset.shipCost);
    if (isNaN(shipCost)) shipCost = 8;

    // Build planId → per_delivery_price map from variant selling_plan_allocations
    var planPriceMap = {};
    function buildPlanPriceMap(variant) {
      planPriceMap = {};
      if (!variant || !variant.selling_plan_allocations) return;
      variant.selling_plan_allocations.forEach(function(alloc) {
        planPriceMap[String(alloc.selling_plan_id)] = alloc.per_delivery_price;
      });
    }
    // Initialise from currently selected variant
    (function() {
      var varEl = document.querySelector('script[data-cst_variant="data"]');
      if (!varEl) return;
      try {
        var variants = JSON.parse(varEl.textContent);
        var initV = variants.find(function(v) { return v.id === {{ product.selected_or_first_available_variant.id }}; });
        if (initV) buildPlanPriceMap(initV);
      } catch(e) {}
    })();

    function money(n) {
      return '$' + n.toFixed(2).replace(/\.00$/, '').replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    var elPrice   = document.getElementById('CroPWPrice-{{ section.id }}');
    var elWas     = document.getElementById('CroPWWas-{{ section.id }}');
    var elSaving  = document.getElementById('CroPWSaving-{{ section.id }}');
    var elNote    = document.getElementById('CroPWNote-{{ section.id }}');
    var elPerks   = document.getElementById('CroPWPerks-{{ section.id }}');
    var elFreq    = document.getElementById('CroPWFreq-{{ section.id }}');
    var elCancel  = document.getElementById('CroPWCancel-{{ section.id }}');
    var elOtNote      = document.getElementById('CroPWOnetimeNote-{{ section.id }}');
    var elNoSubUpsell = document.getElementById('CroPWNoSubUpsell-{{ section.id }}');
    var elNoSubHint   = document.getElementById('CroNoSubHint-{{ section.id }}');
    var elHint        = document.getElementById('CroPWHint-{{ section.id }}');
    var noSubProduct           = pw.dataset.noSub === 'true';
    var currentVariantHasPlans = !noSubProduct && (pw.dataset.variantHasPlans !== '0');
    var atcBtn    = document.getElementById('CroATC-{{ section.id }}');
    var atcLabel  = atcBtn ? atcBtn.querySelector('.cro-atc-btn__label') : null;

    var subNote      = pw.dataset.subNote      || 'Free shipping included — always';
    var otShipping   = pw.dataset.otShipping   || '+ $8 shipping';

    // ── ReCharge element finders ──────────────────────────────
    function rcRadio(val) {
      return document.querySelector('input[name="purchaseOption"][value="' + val + '"]');
    }
    function rcSelect() {
      return document.querySelector('select[name="rc_selling_plan"]');
    }

    function clickRC(val) {
      var r = rcRadio(val);
      if (r) {
        r.checked = true;
        r.dispatchEvent(new Event('change', { bubbles: true }));
        var lbl = r.closest('label');
        if (lbl) lbl.click();
      }
    }
    function setRCPlan(planId) {
      var sel = rcSelect();
      if (sel) {
        sel.value = planId;
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        sel.dispatchEvent(new Event('input',  { bubbles: true }));
      }
      // Set native Shopify selling_plan input so subscription is attached to cart
      var spInput = document.querySelector('input[name="selling_plan"]');
      if (spInput) {
        spInput.value = planId;
        spInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }

    // ── Render subscribe state ────────────────────────────────
    function renderSub(planId, hint) {
      var displayPrice  = (planId && planPriceMap[String(planId)] !== undefined)
                          ? planPriceMap[String(planId)] / 100
                          : subPrice;
      // Product-price difference only. Shipping is deliberately excluded: the
      // shipping status is shown on its own line, and folding it in here made
      // the figure disagree with the two prices on screen (e.g. $75 -> $67.50
      // displayed as "Save $15.50").
      // Product-price difference only on migrated products. Unmigrated 60ml PDPs
      // keep their existing live presentation, which folds the shipping benefit
      // into the figure, until each is migrated and the corrected calculation is
      // validated for that product.
      var displaySaving;
      if (pw.dataset.newUx === 'true') {
        displaySaving = Math.round((onetimePrice - displayPrice) * 100) / 100;
      } else {
        var _legacyShip = onetimePrice >= freeShipThreshold ? 0 : shipCost;
        displaySaving = Math.round((onetimePrice + _legacyShip - displayPrice) * 100) / 100;
      }
      if (elPrice)  elPrice.textContent  = money(displayPrice);
      if (elWas)    elWas.innerHTML      = '<s>' + money(onetimePrice) + '</s> one-time price';
      // Hidden rather than "Save $0.00" if a plan carries no discount.
      if (elSaving) {
        if (displaySaving > 0) {
          elSaving.textContent = 'Save ' + money(displaySaving) + ' per order';
          elSaving.hidden = false;
        } else {
          elSaving.hidden = true;
        }
      }
      if (elNote)   elNote.textContent   = '{{ block.settings.sub_note | default: "Free shipping included — always" }}';
      if (elPerks)  elPerks.hidden       = false;
      if (elFreq)   elFreq.hidden        = false;
      if (elCancel) elCancel.hidden      = false;
      if (elOtNote)      elOtNote.hidden      = true;
      if (elNoSubUpsell) elNoSubUpsell.hidden = true;
      if (elHint && hint) elHint.textContent = hint;
      if (atcLabel) atcLabel.innerHTML   = 'Subscribe — <span class="cro-atc-btn__price">' + money(displayPrice) + '</span>';
      // Per-shot pricing
      var elPerShot = document.getElementById('CroPWPerShot-{{ section.id }}');
      if (elPerShot) {
        var checkedRadio = document.querySelector('.cro-variant-row input[type="radio"]:checked');
        var shotMatch = checkedRadio ? checkedRadio.value.match(/^(\d+)/) : null;
        var shotCount = shotMatch ? parseInt(shotMatch[1]) : {{ block.settings.shots_per_pack | default: 0 }};
        if (shotCount > 0) {
          var perShot = Math.round((displayPrice / shotCount) * 100) / 100;
          var perShotLabel = pw.dataset.perShotLabel || 'Just {price} per shot, delivered to your door.';
          elPerShot.textContent = perShotLabel.replace(/\{price\}/g, money(perShot));
          elPerShot.hidden = false;
        } else {
          elPerShot.hidden = true;
        }
      }
      clickRC('subscription');
      if (planId) setRCPlan(planId);
    }

    // ── Render one-time state ─────────────────────────────────
    function renderOnetime() {
      if (elPrice)  elPrice.textContent  = money(onetimePrice);
      if (elWas)    elWas.innerHTML      = '';
      if (elSaving) elSaving.hidden      = true;
     var _ship = onetimePrice >= freeShipThreshold ? 0 : shipCost;
      var _otTotal = Math.round((onetimePrice + _ship) * 100) / 100;
      var _saving  = Math.round((onetimePrice + _ship - subPrice) * 100) / 100;
      if (elNote) {
        var _otText = _ship === 0
          ? 'One-time: ' + money(onetimePrice) + ' delivered, free shipping included.'
          : 'One-time: ' + money(onetimePrice) + ' + $' + _ship + ' shipping = ' + money(_otTotal) + ' delivered.';
        if (currentVariantHasPlans) {
          var _subText = ' Subscribe: <span style="color:#1D9E75;font-weight:500;">' + money(subPrice) + ' with free shipping always</span>.';
          if (_saving > 0) { _subText += ' Save ' + money(_saving) + ' every order.'; }
          elNote.innerHTML = _otText + _subText + ' Cancel anytime.';
        } else {
          elNote.textContent = _otText;
        }
      }
      if (elPerks)  elPerks.hidden       = true;
      if (elFreq)   elFreq.hidden        = true;
      if (elCancel) elCancel.hidden      = true;
      if (elOtNote)      elOtNote.hidden      = currentVariantHasPlans ? false : true;
      // Upsell only for per-variant no-sub (not when whole product is no-subscription)
      if (elNoSubUpsell) elNoSubUpsell.hidden = (!currentVariantHasPlans && !noSubProduct) ? false : true;
      var elPerShot = document.getElementById('CroPWPerShot-{{ section.id }}');
      if (elPerShot) elPerShot.hidden = true;
      if (atcLabel) atcLabel.innerHTML   = 'Add to cart — <span class="cro-atc-btn__price">' + money(onetimePrice) + '</span>';
      // Only sync ReCharge widget when variant actually has plans (avoids RC's async handlers
      // re-setting selling_plan on no-plan variants like 9-shot)
      if (currentVariantHasPlans) clickRC('onetime');
      // Clear native Shopify selling_plan so one-time purchase doesn't carry a subscription
      var spInput = document.querySelector('input[name="selling_plan"]');
      if (spInput) { spInput.value = ''; spInput.dispatchEvent(new Event('change', { bubbles: true })); }
      croDropPlanFromUrl();
      // Delayed clears: catch any async re-set by ReCharge's event handlers
      setTimeout(function() {
        var sp = document.querySelector('input[name="selling_plan"]');
        if (sp && sp.value) { sp.value = ''; sp.dispatchEvent(new Event('change', { bubbles: true })); }
        croDropPlanFromUrl();
      }, 150);
      setTimeout(function() {
        var sp = document.querySelector('input[name="selling_plan"]');
        if (sp && sp.value) { sp.value = ''; sp.dispatchEvent(new Event('change', { bubbles: true })); }
        croDropPlanFromUrl();
      }, 600);
      // ReCharge writes the parameter later than it re-sets the input — measured
      // around two seconds. Without these the address bar keeps a subscription the
      // customer is not in, and refreshing or sharing that link opens Subscribe.
      setTimeout(croDropPlanFromUrl, 1500);
      setTimeout(croDropPlanFromUrl, 3000);
    }

    // The address bar must not claim a subscription while the buy box says
    // one-time. Guarded on the live mode so it can never fight a customer who has
    // genuinely chosen Subscribe, and it leaves ?variant alone.
    function croDropPlanFromUrl() {
      if (currentMode === 'sub') return;
      try {
        var u = new URL(window.location.href);
        if (!u.searchParams.has('selling_plan')) return;
        u.searchParams.delete('selling_plan');
        window.history.replaceState({}, '', u.pathname + (u.search || '') + u.hash);
      } catch (e) {}
    }

    // Timed passes lose this race — ReCharge re-appends the parameter at no fixed
    // moment, and measured re-appearances landed after every delay we tried. So
    // the write itself is intercepted rather than cleaned up afterwards. Same
    // belt-and-braces reasoning as the /cart/add interception further down, and
    // it only ever removes selling_plan while the customer is in one-time.
    (function () {
      if (window.__croHistoryPatched) return;
      window.__croHistoryPatched = true;
      ['pushState', 'replaceState'].forEach(function (fn) {
        var original = history[fn];
        if (typeof original !== 'function') return;
        history[fn] = function (state, title, url) {
          try {
            if (url != null && currentMode !== 'sub') {
              var u = new URL(url, window.location.href);
              if (u.searchParams.has('selling_plan')) {
                u.searchParams.delete('selling_plan');
                url = u.pathname + (u.search || '') + u.hash;
              }
            }
          } catch (e) {}
          return original.call(this, state, title, url);
        };
      });
    })();

    // ── Toggle buttons ────────────────────────────────────────
    // A clean product URL must open on the smallest pack, one-time. Subscription
    // is pre-selected only when the URL explicitly asks for it — an approved
    // campaign or deep link carrying selling_plan. Every path that used to force
    // Subscribe on load is gated on this.
    // Captured once, before anything consumes it: a pack switch re-renders the
    // buy box, and the customer's intent to subscribe has to survive that. The
    // flag is read here rather than inside croWantsSub because the note-handling
    // code below clears the key, and initPW asks again afterwards.
    // Read once, here, and never again from the URL. ReCharge appends its own
    // `selling_plan` to the address bar within a second of load, even when the
    // customer is sitting in one-time — so by the time the 800ms sync asks, the
    // URL claims a subscription the customer never chose, and the sync clicks
    // Subscribe for them. Captured at parse time, before ReCharge has run, the
    // flag still means what it was built to mean: this link asked for a
    // subscription. Proved on the staging duplicate 19 August — reading it late
    // turned a one-time $84 into a subscription at $75.60 with no interaction.
    var croUrlAskedForSub = false;
    try { croUrlAskedForSub = new URLSearchParams(window.location.search).has('selling_plan'); } catch (e) {}

    var croSwitchKey = 'croPackSwitched-{{ section.id }}';
    var croPendingSubIntent = false;
    try { croPendingSubIntent = sessionStorage.getItem(croSwitchKey) !== null; } catch (e) {}

    // Purchase type carried across a pack change. Changing the pack reloads the
    // whole page — `updateVariantInput` in global.js ends in location.reload() —
    // so the chosen mode cannot survive in a variable. A customer who is already
    // subscribing and then changes pack must stay subscribing, which is only
    // visible on a product with two subscribable packs; Action Shot has one, so
    // the read below is what keeps the rule true for the rest of the range.
    // Read once and deleted immediately: a key left behind would pin the next
    // clean visit into Subscribe, which is the behaviour Phase 1 removed.
    var croModeKey = 'croPackMode-{{ section.id }}';
    var croPendingMode = null;
    try {
      croPendingMode = sessionStorage.getItem(croModeKey);
      if (croPendingMode !== null) sessionStorage.removeItem(croModeKey);
    } catch (e) {}

    function croWantsSub() {
      // Legacy products keep subscribe-first until they are migrated. Only the
      // new experience opens one-time unless the URL asks for a subscription.
      if (pw.dataset.newUx !== 'true') return true;
      // Just moved here by choosing Subscribe — honour that, not the URL.
      if (croPendingSubIntent) return true;
      // Carried over from the pack the customer just left.
      if (croPendingMode === 'sub') return true;
      if (croPendingMode === 'once') return false;
      return croUrlAskedForSub;
    }

    var togBtns = pw.querySelectorAll('.cro-pw__tog-btn');
    var currentMode = croWantsSub() ? 'sub' : 'once';
    togBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        togBtns.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        currentMode = btn.dataset.mode;
        croSyncHint();
        if (currentMode === 'sub') {
          var activeFreq = pw.querySelector('.cro-pw__freq-btn.is-active');
          var planId = activeFreq ? activeFreq.dataset.planId : (pw.querySelector('.cro-pw__freq-btn') ? pw.querySelector('.cro-pw__freq-btn').dataset.planId : '');
          var hint   = activeFreq ? activeFreq.dataset.hint   : '';
          renderSub(planId, hint);
        } else {
          renderOnetime();
        }
      });
    });

    // ── Carry the purchase type across a pack change ──────────
    // Written in the capture phase so it lands before variant-radios starts the
    // reload. Trusted events only: the auto-switch and the sold-out resolver both
    // change the radio programmatically, and neither is the customer choosing a
    // purchase type. The auto-switch is unaffected either way — croWantsSub reads
    // its own key first, so an explicit Subscribe still wins over a carried mode.
    document.addEventListener('change', function (e) {
      var t = e.target;
      if (!t || t.type !== 'radio' || !e.isTrusted) return;
      if (!t.closest('.cro-variant-row, .cro-variant-row--cards')) return;
      try { sessionStorage.setItem(croModeKey, currentMode); } catch (err) {}
    }, true);

    // ── Auto-switch to a subscribable pack ────────────────────
    // Choosing Subscribe on a pack with no selling plan moves the customer to
    // the pack that has one, and says so. Only ever on a genuine user action:
    // the 800ms ReCharge sync and the sticky-bar mirror both use programmatic
    // .click(), and neither may move the customer's pack underneath them.
    var SWITCH_KEY = croSwitchKey;

    function croFindSubscribableVariant() {
      var el = document.querySelector('[data-cst_variant="data"]');
      if (!el) return null;
      try {
        var vs = JSON.parse(el.textContent);
        for (var i = 0; i < vs.length; i++) {
          var v = vs[i];
          if (v.available && v.selling_plan_allocations && v.selling_plan_allocations.length > 0) return v;
        }
      } catch (e) {}
      return null;
    }

    function croShowSwitchNote(label) {
      var note = document.getElementById('CroPWSwitchNote-{{ section.id }}');
      if (!note || !label) return;
      var tpl = note.dataset.template || 'Subscriptions are available on the [pack]. We’ve updated your selection.';
      note.textContent = tpl.replace('[pack]', label);
      note.hidden = false;
    }

    // The variant change re-renders the buy box, so the note is handed across
    // in sessionStorage rather than written straight to the DOM.
    try {
      var pendingSwitch = sessionStorage.getItem(SWITCH_KEY);
      if (pendingSwitch) {
        sessionStorage.removeItem(SWITCH_KEY);
        croShowSwitchNote(pendingSwitch);
      }
    } catch (e) {}

    // ── Sold-out pack requested by a deep link or saved selection ──
    // Move to an available pack and say so. Uses the same sessionStorage
    // handoff as the subscribe switch, because changing the variant re-renders
    // the buy box and would discard a message written straight to the DOM.
    var SOLDOUT_KEY = 'croSoldOutSwitch-{{ section.id }}';
    var soldOutNote = document.getElementById('CroPWSoldOutSwitch-{{ section.id }}');

    try {
      var pendingOut = sessionStorage.getItem(SOLDOUT_KEY);
      if (pendingOut && soldOutNote) {
        sessionStorage.removeItem(SOLDOUT_KEY);
        var parts = pendingOut.split('|');
        var tpl = soldOutNote.dataset.template || 'The [pack] is sold out. We’ve selected the [available].';
        soldOutNote.textContent = tpl.replace('[pack]', parts[0]).replace('[available]', parts[1]);
        soldOutNote.hidden = false;
      }
    } catch (e) {}

    function croShowSoldOutNote(outPack, availPack) {
      if (!soldOutNote) return;
      var tpl = soldOutNote.dataset.template || 'The [pack] is sold out. We’ve selected the [available].';
      soldOutNote.textContent = tpl.replace('[pack]', outPack).replace('[available]', availPack);
      soldOutNote.hidden = false;
    }

    function croResolveSoldOutSelection() {
      if (!soldOutNote || soldOutNote.dataset.active !== 'true') return;
      var outPack = soldOutNote.dataset.soldoutPack;
      var availPack = soldOutNote.dataset.availablePack;
      var radios = document.querySelectorAll('.cro-variant-row--cards input[type="radio"], .cro-variant-row input[type="radio"]');
      for (var i = 0; i < radios.length; i++) {
        if (radios[i].value === availPack && !radios[i].disabled) {
          try { sessionStorage.setItem(SOLDOUT_KEY, outPack + '|' + availPack); } catch (err) {}
          // checked + bubbling change, not .click(): variant-radios listens for
          // change, and this has to survive running before the element upgrades.
          radios[i].checked = true;
          radios[i].dispatchEvent(new Event('change', { bubbles: true }));
          // Shown now in case the buy box is updated in place rather than
          // re-rendered; the sessionStorage handoff covers the re-render case.
          croShowSoldOutNote(outPack, availPack);
          break;
        }
      }
    }

    // Deferred: running at parse time changes `checked` before variant-radios
    // has upgraded, so Dawn never sees the change and the price goes stale.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', croResolveSoldOutSelection);
    } else {
      croResolveSoldOutSelection();
    }

    var croSubToggle = pw.querySelector('.cro-pw__tog-btn[data-mode="sub"]');
    if (croSubToggle) {
      croSubToggle.addEventListener('click', function (e) {
        if (!e.isTrusted && !window._croUserInitiated) return;
        if (pw.dataset.noSub === 'true') return;
        if (pw.dataset.variantHasPlans !== '0') return;  // current pack already subscribable
        var target = croFindSubscribableVariant();
        if (!target) return;                             // nothing valid — never switch silently
        var radios = document.querySelectorAll('.cro-variant-row input[type="radio"], .cro-variant-row--cards input[type="radio"]');
        for (var i = 0; i < radios.length; i++) {
          if (radios[i].value === target.options[0] && !radios[i].disabled) {
            try { sessionStorage.setItem(SWITCH_KEY, target.title); } catch (err) {}
            radios[i].click();
            return;
          }
        }
      }, true);
    }

    // ── Analytics ─────────────────────────────────────────────
    // Every event carries pack + purchase type, because the questions GOJU
    // wants answered are about the combination, not either alone.
    function croCurrentPack() {
      var checked = document.querySelector('.cro-variant-row--cards input[type="radio"]:checked, .cro-variant-row input[type="radio"]:checked');
      return checked ? checked.value : '{{ product.selected_or_first_available_variant.title | escape }}';
    }
    function croCurrentType() {
      return currentMode === 'sub' ? 'subscription' : 'one_time';
    }
    function croCurrentValue() {
      if (currentMode === 'sub') {
        var activeFreq = pw.querySelector('.cro-pw__freq-btn.is-active');
        var planId = activeFreq ? activeFreq.dataset.planId : null;
        if (planId && planPriceMap[String(planId)] !== undefined) return planPriceMap[String(planId)] / 100;
        return subPrice;
      }
      return onetimePrice;
    }
    function croTrack(name, extra) {
      window.dataLayer = window.dataLayer || [];
      var payload = {
        event: name,
        product: '{{ product.title | escape }}',
        product_handle: '{{ product.handle }}',
        pack: croCurrentPack(),
        purchase_type: croCurrentType(),
        value: croCurrentValue(),
        currency: '{{ cart.currency.iso_code }}'
      };
      if (extra) { for (var k in extra) { payload[k] = extra[k]; } }
      window.dataLayer.push(payload);
    }

    // Registered after the toggle's own handler so currentMode is already
    // updated. Guarded on real user intent — the 800ms ReCharge sync clicks
    // Subscribe on every page load, which would otherwise report as a choice
    // the customer never made.
    pw.querySelectorAll('.cro-pw__tog-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        if (!e.isTrusted && !window._croUserInitiated) return;
        croTrack('purchase_type_selected');
      });
    });

    // Capture phase: the variant change re-renders the buy box, so the event
    // has to be pushed before that work starts.
    document.addEventListener('change', function (e) {
      if (!e.target || e.target.type !== 'radio') return;
      if (!e.target.closest('.cro-variant-row--cards, .cro-variant-row')) return;
      if (!e.isTrusted) return;   // auto-switch is reported as a purchase-type choice, not a pack choice
      croTrack('pack_selected', { pack: e.target.value });
    }, true);

    var croForm = document.getElementById('{{ product_form_id }}');
    if (croForm) {
      croForm.addEventListener('submit', function () {
        croTrack('add_to_cart');
      }, true);
    }

    // ── Hint visibility ───────────────────────────────────────
    // The hint tells the customer what choosing Subscribe will do, so it has no
    // job once they have chosen it — and leaving it up stacks "Selecting
    // Subscribe switches to the 12-pack" directly above "Your pack has been
    // updated". The approved prototype leaves it visible in both states; this
    // is a deliberate improvement on that.
    // The unavailable message is exempt: it explains why Subscribe cannot be
    // used at all, so it stays regardless.
    var croHintLine = document.getElementById('CroPWHintLine-{{ section.id }}');
    function croSyncHint() {
      if (!croHintLine || croHintLine.dataset.persist === 'true') return;
      croHintLine.hidden = currentMode === 'sub';
    }

    // ── Frequency buttons ─────────────────────────────────────
    var freqBtns = pw.querySelectorAll('.cro-pw__freq-btn');
    freqBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        freqBtns.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        if (elHint) elHint.textContent = btn.dataset.hint || '';
        setRCPlan(btn.dataset.planId);
        renderSub(btn.dataset.planId, btn.dataset.hint);
      });
    });

    // ── Upsell link — switch to the first variant that has plans ──
    var noSubLink = document.getElementById('CroPWNoSubLink-{{ section.id }}');
    if (noSubLink) {
      noSubLink.addEventListener('click', function(e) {
        e.preventDefault();
        var variantData = document.querySelector('script[data-cst_variant="data"]');
        if (!variantData) return;
        try {
          var variants = JSON.parse(variantData.textContent);
          var planVariant = variants.find(function(v) {
            return v.selling_plan_allocations && v.selling_plan_allocations.length > 0;
          });
          if (!planVariant) return;
          var optionValue = planVariant.options[0];
          var radios = document.querySelectorAll('.cro-variant-row input[type="radio"]');
          for (var i = 0; i < radios.length; i++) {
            if (radios[i].value === optionValue) {
              var lbl = document.querySelector('label[for="' + radios[i].id + '"]');
              if (lbl) lbl.click();
              break;
            }
          }
        } catch (err) {}
      });
    }

    // ── Init on load ──────────────────────────────────────────
    function initPW() {
      // No-subscription product or variant with no plans — lock to one-time mode
      if (pw.dataset.noSub === 'true') {
        currentMode = 'once';
        var toggle = pw.querySelector('.cro-pw__toggle');
        if (toggle) toggle.hidden = true;
        renderOnetime();
        return;
      }
      // Initial variant has no plans — show One-time only (e.g. 9-shot pack).
      // The toggle itself stays when another pack can be subscribed to, so the
      // customer still has a way to ask for a subscription.
      if (pw.dataset.variantHasPlans === '0') {
        currentMode = 'once';
        var toggle = pw.querySelector('.cro-pw__toggle');
        if (toggle) toggle.hidden = pw.dataset.subElsewhere !== 'true';
        if (toggle && pw.dataset.subElsewhere === 'true') {
          toggle.querySelectorAll('.cro-pw__tog-btn').forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.mode === 'once');
          });
        }
        if (elPerks)  elPerks.hidden  = true;
        if (elFreq)   elFreq.hidden   = true;
        if (elCancel) elCancel.hidden = true;
        renderOnetime();
        return;
      }
      // Clean visit — open on one-time. The subscribe panels stay hidden until
      // the customer chooses Subscribe.
      if (!croWantsSub()) {
        currentMode = 'once';
        pw.querySelectorAll('.cro-pw__tog-btn').forEach(function (b) {
          b.classList.toggle('is-active', b.dataset.mode === 'once');
        });
        if (elPerks)  elPerks.hidden  = true;
        if (elFreq)   elFreq.hidden   = true;
        if (elCancel) elCancel.hidden = true;
        renderOnetime();
        return;
      }

      currentMode = 'sub';
      // Set default frequency button
      var defBtn = pw.querySelector('.cro-pw__freq-btn.is-active') || pw.querySelector('.cro-pw__freq-btn');
      if (defBtn) {
        freqBtns.forEach(function(b){ b.classList.remove('is-active'); });
        defBtn.classList.add('is-active');
      }
      var planId = defBtn ? defBtn.dataset.planId : '';
      var hint   = defBtn ? defBtn.dataset.hint   : '';
      renderSub(planId, hint);
      // Poll for 3s — re-assert Subscribe if ReCharge overrides it (even without firing events)
      var pollCount = 0;
      var pollTimer = setInterval(function() {
        if (currentMode !== 'sub' || ++pollCount > 15) { clearInterval(pollTimer); return; }
        var subRadio = rcRadio('subscription');
        if (subRadio && !subRadio.checked) {
          togBtns.forEach(function(b) { b.classList.toggle('is-active', b.dataset.mode === 'sub'); });
          renderSub(planId, hint);
        }
      }, 200);
    }

    // ── Handle variant switch — show/hide sub UI per variant ──────
    // Ignore variant:change events while still on the initial variant (fired multiple times by
    // Dawn + ReCharge on page load). Only update when the user navigates to a different variant.
    var initialVariantId = {{ product.selected_or_first_available_variant.id }};
    var departedfromInitial = false;

    document.addEventListener('variant:change', function(e) {
      var variant = e.detail && e.detail.variant;
      if (!variant) return;

      // Update prices for every variant:change (safe — just math)
      rawPrice     = variant.price;
      onetimePrice = rawPrice / 100;
      subPrice     = Math.round(rawPrice * (1 - discount / 100)) / 100;
      saving       = Math.round((onetimePrice - subPrice) * 100) / 100;
      buildPlanPriceMap(variant);

      // Mark when user has navigated away from the initial variant
      if (variant.id !== initialVariantId) departedfromInitial = true;

      // While still on the initial variant, don't touch the purchase widget UI —
      // initPW() already set it correctly and the 800ms sync will finalise ReCharge state.
      if (!departedfromInitial) return;

      var hasPlans = !noSubProduct && !!(variant.selling_plan_allocations && variant.selling_plan_allocations.length > 0);
      currentVariantHasPlans = hasPlans;
      var toggle   = pw.querySelector('.cro-pw__toggle');

      // Update the "one-time only" hint below variant buttons
      if (elNoSubHint) elNoSubHint.hidden = hasPlans;

      if (!hasPlans) {
        currentMode = 'once';
        pw.dataset.variantHasPlans = '0';
        if (toggle)   toggle.hidden   = true;
        if (elPerks)  elPerks.hidden  = true;
        if (elFreq)   elFreq.hidden   = true;
        if (elCancel) elCancel.hidden = true;
        var spInput = document.querySelector('input[name="selling_plan"]');
        if (spInput) {
          spInput.value = '';
          spInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        renderOnetime();
      } else {
        pw.dataset.variantHasPlans = '1';
        if (toggle) toggle.hidden = false;
        // Landing on a subscribable pack does not make the customer a subscriber.
        // This used to force Subscribe, which broke the rule that only an explicit
        // Subscribe click moves the purchase type. Nothing in the theme dispatches
        // variant:change — an app does — so this must never be an entry point to
        // subscription. Where the pack genuinely has no plan the branch above
        // still drops to one-time, because there is no subscription to keep.
        togBtns.forEach(function(b) { b.classList.toggle('is-active', b.dataset.mode === currentMode); });
        if (currentMode === 'sub') {
          var activeFreq = pw.querySelector('.cro-pw__freq-btn.is-active');
          var planId = activeFreq ? activeFreq.dataset.planId : (pw.querySelector('.cro-pw__freq-btn') ? pw.querySelector('.cro-pw__freq-btn').dataset.planId : '');
          var hint   = activeFreq ? activeFreq.dataset.hint   : '';
          renderSub(planId, hint);
        } else {
          if (elPerks)  elPerks.hidden  = true;
          if (elFreq)   elFreq.hidden   = true;
          if (elCancel) elCancel.hidden = true;
          renderOnetime();
        }
      }
    });

    // Run immediately for visual state
    initPW();
    croSyncHint();
    // After 800ms: simulate clicks to sync all 3 layers (UI + ReCharge + Shopify selling_plan)
    setTimeout(function() {
      if (!croWantsSub()) return;                     // clean visit stays one-time
      if (pw.dataset.noSub === 'true') return;
      if (pw.dataset.variantHasPlans === '0') return; // 9-shot or other no-plan variant — stay One-time
      var subBtn = pw.querySelector('.cro-pw__tog-btn[data-mode="sub"]');
      var firstPlanBtn = pw.querySelector('.cro-pw__freq-btn.is-active') || pw.querySelector('.cro-pw__freq-btn');
      var spInput = document.querySelector('input[name="selling_plan"]');
      if (subBtn) subBtn.click();
      if (firstPlanBtn) firstPlanBtn.click();
      if (spInput && firstPlanBtn) spInput.value = firstPlanBtn.dataset.planId;
    }, 800);

    // Safety net: clear selling_plan before form submit if current variant has no plans
    var productForm = document.getElementById('{{ product_form_id }}');
    if (productForm) {
      productForm.addEventListener('submit', function() {
        if (pw.dataset.variantHasPlans === '0' || currentMode === 'once') {
          var spInput = document.querySelector('input[name="selling_plan"]');
          if (spInput) spInput.value = '';
        }
      }, true); // capture phase — runs before ReCharge can interfere
    }
    // Belt-and-suspenders: intercept fetch to strip selling_plan from /cart/add
    // when the variant *being added* has no subscription plans (e.g. 9-shot).
    // Dawn sends FormData; ReCharge may send JSON or URLSearchParams — handle all formats.
    //
    // The test is on the variant in the request, not the one on screen. Keying it
    // to the displayed pack meant that while the customer looked at the 6-pack —
    // which holds no plans — every add lost its selling plan, including a genuine
    // 12-pack subscription added by an upsell, a cross-sell or the cart drawer.
    // Proved on the staging duplicate 19 August: the same subscription add gave
    // $75.60 with the 4-week plan through an unpatched request and $84 with no
    // plan through this one.
    //
    // Unknown variants are left alone. Stripping a plan the customer asked for
    // charges them the one-time price and silently creates no subscription;
    // leaving one on a variant that cannot take it makes Shopify reject the add
    // with a visible error. Between a silent wrong charge and a loud failure,
    // this errs towards the loud one.
    (function() {
      function croVariantIsPlanless(id) {
        if (!id) return false;
        var el = document.querySelector('[data-cst_variant="data"]');
        if (!el) return false;
        try {
          var vs = JSON.parse(el.textContent);
          for (var i = 0; i < vs.length; i++) {
            if (String(vs[i].id) === String(id)) {
              return !(vs[i].selling_plan_allocations && vs[i].selling_plan_allocations.length > 0);
            }
          }
        } catch (e) {}
        return false;
      }

      var _origFetch = window.fetch;
      window.fetch = function(resource, init) {
        var url = typeof resource === 'string' ? resource
                : (resource && resource.url) ? resource.url : '';
        if (url.indexOf('/cart/add') !== -1 && init && init.body) {
          if (init.body instanceof FormData || init.body instanceof URLSearchParams) {
            if (croVariantIsPlanless(init.body.get('id'))) init.body.delete('selling_plan');
          } else if (typeof init.body === 'string') {
            try {
              var body = JSON.parse(init.body);
              // /cart/add.js takes either a single line or an items array.
              if (Array.isArray(body.items)) {
                body.items.forEach(function (line) {
                  if (line && croVariantIsPlanless(line.id)) delete line.selling_plan;
                });
              } else if (croVariantIsPlanless(body.id)) {
                delete body.selling_plan;
              }
              init = Object.assign({}, init, { body: JSON.stringify(body) });
            } catch(e) {
              try {
                var params = new URLSearchParams(init.body);
                if (croVariantIsPlanless(params.get('id'))) {
                  params.delete('selling_plan');
                  init = Object.assign({}, init, { body: params.toString() });
                }
              } catch(e2) {}
            }
          }
        }
        return _origFetch.call(window, resource, init);
      };
    })();
  })();

  // ── Panel accordion (How to Take, Ingredients, Shipping) ─────
  (function () {
    var accItems = document.querySelectorAll('.cro-panel-acc-item');
    accItems.forEach(function (det) {
      var body = det.querySelector('.cro-panel-acc-item__body');
      body.style.overflow = 'hidden';
      body.style.height = '0px';
      body.style.transition = 'height 0.3s ease';

      det.querySelector('summary').addEventListener('click', function (e) {
        e.preventDefault();
        if (det.open) {
          body.style.height = body.scrollHeight + 'px';
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { body.style.height = '0px'; });
          });
          body.addEventListener('transitionend', function h() {
            det.open = false;
            body.removeEventListener('transitionend', h);
          });
        } else {
          det.open = true;
          body.style.height = body.scrollHeight + 'px';
          body.addEventListener('transitionend', function h() {
            body.style.height = 'auto';
            body.removeEventListener('transitionend', h);
          });
        }
      });
    });
  })();

  // ── Read More / Read Less description toggle ──────────────────
  function initReadMore(sectionId) {
    var btn  = document.getElementById('CroReadMoreBtn-' + sectionId);
    var full = document.getElementById('CroDescFull-' + sectionId);
    if (!btn || !full) return;

    // Set initial collapsed state
    full.style.height = '0px';
    full.style.overflow = 'hidden';
    full.style.transition = 'height 0.35s ease';

    var preview = btn.closest('.cro-info-panel__short-desc') && btn.closest('.cro-info-panel__short-desc').querySelector('.cro-short-desc');

    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        full.style.height = full.scrollHeight + 'px';
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            full.style.height = '0px';
          });
        });
        full.addEventListener('transitionend', function handler() {
          full.setAttribute('aria-hidden', 'true');
          full.removeEventListener('transitionend', handler);
        });
        btn.setAttribute('aria-expanded', 'false');
        btn.querySelector('.cro-read-more-btn__text').textContent = btn.dataset.label || 'Read More';
        btn.classList.remove('is-open');
        if (preview) preview.style.display = '';
      } else {
        full.setAttribute('aria-hidden', 'false');
        full.style.height = full.scrollHeight + 'px';
        full.addEventListener('transitionend', function handler() {
          full.style.height = 'auto';
          full.removeEventListener('transitionend', handler);
        });
        btn.setAttribute('aria-expanded', 'true');
        btn.querySelector('.cro-read-more-btn__text').textContent = 'Read Less';
        btn.classList.add('is-open');
        if (preview) preview.style.display = 'none';
      }
    });
  }

  // ── Scroll-to-section links ───────────────────────────────────
  function initScrollLinks() {
    document.querySelectorAll('.cro-scroll-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        var target = document.querySelector(link.getAttribute('href'));
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  // ── Auto-select first subscription-enabled variant on page load ──
  // If the default variant has no plans (e.g. 9-shot), switch to the first
  // variant that does (e.g. 15-shot) so Subscribe & Save shows by default.
  function autoSelectPlanVariant() {
    // Deep-link resolution only: if a link asks for a subscription on a variant
    // that has no selling plan, move to the nearest variant that does.
    //
    // This used to run on every visit with no ?variant, which is what made a
    // clean product URL open on the larger pack. A clean URL must now open on
    // the smallest pack, one-time, so this is gated on selling_plan being asked
    // for explicitly.
    var params = new URLSearchParams(window.location.search);
    var pwEl = document.getElementById('CroPW-{{ section.id }}');
    var newUx = pwEl && pwEl.dataset.newUx === 'true';
    // Legacy products keep the old behaviour: jump to the subscribable variant
    // on any visit without an explicit ?variant.
    if (newUx && !params.has('selling_plan')) return;
    if (params.has('variant')) return;
    var pw = document.getElementById('CroPW-{{ section.id }}');
    if (!pw || pw.dataset.noSub === 'true') return;
    if (pw.dataset.variantHasPlans !== '0') return; // already on a plan variant
    var varEl = document.querySelector('script[data-cst_variant="data"]');
    if (!varEl) return;
    try {
      var allVariants = JSON.parse(varEl.textContent);
      var planVariant = allVariants.find(function(v) {
        return v.available && v.selling_plan_allocations && v.selling_plan_allocations.length > 0;
      });
      if (!planVariant) return;
      var variantRadios = document.querySelector('variant-radios.cro-variant-row');
      if (!variantRadios) return;
      var radios = variantRadios.querySelectorAll('input[type="radio"]');
      planVariant.options.forEach(function(optVal) {
        var radio = Array.from(radios).find(function(r) { return r.value === optVal && !r.checked; });
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    } catch(e) {}
  }

  // ── Init on DOM ready ─────────────────────────────────────────
  // ── Sample Pack click tracking ────────────────────────────────
  // Delegated so it survives Dawn re-rendering the buy box on variant change.
  function initSamplePackTracking() {
    document.addEventListener('click', function(e) {
      var link = e.target.closest ? e.target.closest('[data-cro-sample-link]') : null;
      if (!link) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'sample_pack_click',
        landing_product: '{{ product.title | escape }}',
        landing_product_handle: '{{ product.handle }}',
        destination: link.getAttribute('href') || ''
      });
    }, true);
  }

  document.addEventListener('DOMContentLoaded', function() {
    CroGallery('{{ section.id }}');
    CroStickyATC('{{ section.id }}');
    initScrollLinks();
    initReadMore('{{ section.id }}');
    autoSelectPlanVariant();
    initSamplePackTracking();
  });

  // Re-init on Shopify theme editor section reload
  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      CroGallery('{{ section.id }}');
      CroStickyATC('{{ section.id }}');
      initReadMore('{{ section.id }}');
    }
  });
})();
</script>

<script>
/* Fix: Bootstrap 5.0.x does NOT teleport modals to <body> when they have a parent
   element — the modal stays inside .cro-gallery (position:sticky stacking context),
   preventing it from painting above the right info panel. Move them manually. */
(function () {
  function teleportModals() {
    ['#nutrition-popup', '#custom-popup'].forEach(function (id) {
      var el = document.querySelector(id);
      if (el && el.parentElement !== document.body) {
        document.body.appendChild(el);
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', teleportModals);
  } else {
    teleportModals();
  }
})();
</script>

{% schema %}
{
  "name": "CRO Product Page",
  "tag": "section",
  "class": "section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "text",
      "name": "Product Tagline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Tagline",
          "label": "Text"
        },
        {
          "type": "select",
