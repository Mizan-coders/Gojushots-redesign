{% style %}
  .announcement-bar--goju {
    background-color: {{ section.settings.bg_color | default: '#191917' }};
    border-bottom: none;
    padding: 10px 20px;
    position: relative;
  }
  .announcement-bar--goju .ab__slider {
    position: relative;
    height: 1.4em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .announcement-bar--goju .ab__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--goju-accent);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .announcement-bar--goju .ab__slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .announcement-bar--goju .ab__slide a {
    color: var(--goju-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .announcement-bar--goju .ab__slide a:hover {
    text-decoration: underline;
    background: none;
  }
  .announcement-bar--goju .ab__slide .icon-arrow {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--goju-accent);
  }
  @media screen and (max-width: 749px) {
    .announcement-bar--goju .ab__slide { font-size: 13px; }
  }
{% endstyle %}

{%- assign visible_blocks = section.blocks | where: 'type', 'announcement' -%}

<div class="announcement-bar announcement-bar--goju" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="ab__slider" id="AbSlider-{{ section.id }}">
    {%- for block in visible_blocks -%}
      {%- if block.settings.text != blank -%}
        <span class="ab__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="focus-inset">
              {{- block.settings.text | escape -}}
              {%- render 'icon-arrow' -%}
            </a>
          {%- else -%}
            {{- block.settings.text | escape -}}
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
(function() {
  var slider = document.getElementById('AbSlider-{{ section.id }}');
  if (!slider) return;
  var slides = Array.from(slider.querySelectorAll('.ab__slide'));
  if (slides.length <= 1) return;
  var current = 0;
  setInterval(function() {
    slides[current].classList.remove('is-active');
    current = (current + 1) % slides.length;
    slides[current].classList.add('is-active');
  }, {{ section.settings.interval | default: 4000 }});
})();
</script>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#191917"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per message",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "unit": "ms"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}
