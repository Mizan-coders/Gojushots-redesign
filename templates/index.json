    "homepage_why_goju_cWe97M": {
      "type": "homepage-why-goju",
      "blocks": {
        "row_dzN7Tc": {
          "type": "row",
          "settings": {
            "feature": "Ingredient List Proud",
            "goju_text": "We publish our traceable, natural, high potency ingredient list with pride on our labels.",
            "competitor_text": "Tiny and hidden, with ingredients they'd prefer you not to see."
          }
        },
        "row_xjzymr": {
          "type": "row",
          "settings": {
            "feature": "No Water or Filler",
            "goju_text": "Water is great but not in a wellness shot. Expect only quality ingredients.",
            "competitor_text": "Water listed as their first ingredient, diluting and cheapening their product."
          }
        },
        "row_qjUqei": {
          "type": "row",
          "settings": {
            "feature": "Organic Ingredients",
            "goju_text": "We use organic ingredients wherever possible because clean input matters.",
            "competitor_text": "Conventional ingredients sprayed with pesticides."
          }
        },
        "row_RdPgdk": {
          "type": "row",
          "settings": {
            "feature": "Made in New Zealand",
            "goju_text": "Locally sourced ingredients, small batch quality, manufactured in NZ.",
            "competitor_text": "Mass-produced overseas with little transparency on sourcing."
          }
        },
        "row_fiKtf4": {
          "type": "row",
          "settings": {
            "feature": "100% Natural",
            "goju_text": "No additives, fillers, preservatives, artificial colours or sweeteners.",
            "competitor_text": "Often contain \"natural flavours,\" sweeteners, gums, emulsifiers and preservatives."
          }
        },
        "row_kkzdUT": {
          "type": "row",
          "disabled": true,
          "settings": {
            "feature": "No Preservatives",
            "goju_text": "What you drink is exactly what nature made — nothing added.",
            "competitor_text": "Rely on preservatives to extend shelf life at the cost of quality."
          }
        },
        "row_DGkzWz": {
          "type": "row",
          "settings": {
            "feature": "Subscription Flexibility",
            "goju_text": "Pause, skip or cancel anytime. No lock-in, no questions asked.",
            "competitor_text": "Locked-in contracts with difficult cancellation processes."
          }
        }
      },
